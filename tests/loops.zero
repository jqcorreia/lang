import "std:c"

fn number() -> i32 {
    return 42
}

fn main() {
    for a in 0..=10 {
        printf("a: %d\n", a)
    }

    for b in 10..=0 {
        printf("b: %d\n", b)
    }

    for c in 1..number() {
        printf("c: %d\n", c)
    }

    d := 10 
    for d > 0 {
        printf("d: %d\n", d)
        d -= 1
    }
}
