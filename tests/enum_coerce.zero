import "std:c"

enum Flags {
    A = 0x00000040
    B = 0x00010000
    C = 0xFF
}

fn take_u8(x: u8) {
    printf("u8: %d\n", x)
}

fn take_u32(x: u32) {
    printf("u32: %d\n", x)
}

fn take_i32(x: i32) {
    printf("i32: %d\n", x)
}

fn main() {
    // Direct enum member -> coerce to various ints
    take_u8(Flags.C)       // 255
    take_u32(Flags.B)      // 65536
    take_i32(Flags.A)      // 64

    // Enum variable -> coerce
    f: Flags = Flags.A
    take_i32(f)            // 64
    take_u32(f)            // 64

    g: Flags = Flags.C
    take_u8(g)             // 255
}
