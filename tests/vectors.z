import "std:c"

external "m" {
    fn sqrt(v: f64) -> f64
}

struct Vec {
    x: f64
    y: f64
}

fn vec_add(v1: Vec, v2: Vec) -> Vec {
    return Vec { 
        x = v1.x + v2.x, 
        y = v1.y + v2.y 
    }
}

fn vec_dist(v1: Vec, v2: Vec) -> f64 {
    x := (v2.x - v1.x) * (v2.x - v1.x) 
    y := (v2.y - v1.y) * (v2.y - v1.y) 

    return sqrt(x + y)
}

fn main() {
    v1: Vec = Vec { x = 100, y = 100 }
    v2: Vec = Vec { x = 60, y = 70 }

    v := vec_add(v1, v2)
    printf("%f\n", v.x)
    printf("%f\n", vec_dist(v1, v2))
}
