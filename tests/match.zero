import "std:c"

enum Number {
    One
    Two
}

fn main() {
    a := 100

    // Normal match
    match a {
        100 => { 
            printf("One Hundred\n") 
        }
    }

    for i in 0..10 {
        match i {
            2 => { 
                printf("two\n")
            }
            7 => { 
                printf("seven\n")
            }
        }
    }

    n := Number.One
    match n {
        .One => {
            b := 42
            printf("ONE BUT IN BIG and a forty two: %d\n", b) 
        }
    }

}
