import "std:c"

fn main() {
    a := 100

    match a {
        100 => { 
            printf("One Hundred\n") 
        }
    }

    for i in 0..10 {
        match i {
            2 => { 
                printf("two\n")
            }
            7 => { 
                printf("seven\n")
            }
        }
    }
}
