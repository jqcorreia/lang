import "std:c"

fn main() {
    a: [4]i32 = [1, 2, 3, 4]
    b: [4]i32 = [10, 20, 30, 40]

    c := a + b
    printf("c: [%d, %d, %d, %d]\n", c[0], c[1], c[2], c[3]) // 11 22 33 44

    fa: [4]f32 = [1.0, 2.0, 3.0, 4.0]
    fb: [4]f32 = [0.5, 0.5, 0.5, 0.5]

    fc := fa + fb
    printf("fc: [%f, %f, %f, %f]\n", fc[0], fc[1], fc[2], fc[3]) 
    fc = fa * fb
    printf("fc: [%f, %f, %f, %f]\n", fc[0], fc[1], fc[2], fc[3]) 
    fc = fa / fb
    printf("fc: [%f, %f, %f, %f]\n", fc[0], fc[1], fc[2], fc[3])
    fc = fa - fb
    printf("fc: [%f, %f, %f, %f]\n", fc[0], fc[1], fc[2], fc[3])

    fc = fa * 2
}
