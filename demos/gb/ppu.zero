SCX_ADDR :: 0xFF41
SCY_ADDR :: 0xFF42

fn ppu_tick(cycles: u16) {
    dev.ppu.dots = dev.ppu.dots + cycles

    if dev.ppu.dots > 456 {
        dev.ppu.dots = dev.ppu.dots - 456 // subtract, do not zero
        ly := dev.ram[dev.ppu.ly] + 1 // increate LY 
        if ly > 153  { ly = 0 } // wrap around
        dev.ram[dev.ppu.ly] = ly
        // If LY == 144 enable Vblank interrupt
        if ly == 144 {
            dev.ram[0xFF0F] = dev.ram[0xFF0F] | 0x01 
            dev.ppu.frame_ready = true
        }
    }
}

fn draw_tile_id(id: u16, x: u32, y: u32) {
    for ty in 0..8 {
        lo := dev.ram[0x8000 + (id * 16) + (ty * 2)]
        hi := dev.ram[0x8000 + (id * 16) + (ty * 2) + 1]
        for tx in 0..8 {
            bit := 7 - tx
            color := (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)

            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3]     = shades[color].r
            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3 + 1] = shades[color].g
            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3 + 2] = shades[color].b
        }
    }
}

fn draw_background() {
    scx := dev.ram[SCX_ADDR]
    scy := dev.ram[SCY_ADDR]

    for by in 0..(144 / 8) {
        for bx in 0..(160 / 8){
            tile_id := u16(dev.ram[0x9800 + (by * 32 + bx)])
            draw_tile_id(tile_id, bx * 8, by * 8)
        }
    }
}

fn draw_window() {
    for by in 0..(144 / 8) {
        for bx in 0..(160 / 8){
            tile_id := u16(dev.ram[0x9C00 + (by * 32 + bx)])
            draw_tile_id(tile_id, bx * 8, by * 8)
        }
    }

}

fn draw() {
    reg := dev.ram[0xFF40]
    lcd_c := convert_to_lcd_control(reg)
    printf("LCD reg = %02x\n", reg)
    printf("tilemap_base = %04x\n", lcd_c.window_tile_map_base)

    draw_background()
}

struct LCDControl {
    enabled: bool
    window_tile_map_base: u16
    window_enable: bool
    tile_data_base: u16
    bg_tile_map_base: u16
    obj_size: bool // false = 8x8, true = 8 x 16 
    obj_enable: bool
    bg_window_enable: bool
}

fn convert_to_lcd_control(b: u8) -> LCDControl {

    res := LCDControl{}

    res.enabled = b >> 7 & 1 == 1
    if b >> 6 & 1 == 0 {
        res.window_tile_map_base = 0x9800
    } else {
        res.window_tile_map_base = 0x9c00
    }

    return res
}
