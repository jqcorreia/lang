SCY_ADDR :: 0xFF42
SCX_ADDR :: 0xFF43

fn ppu_tick(cycles: u16) {
    dev.ppu.dots = dev.ppu.dots + cycles

    if dev.ppu.dots > 456 {
        dev.ppu.dots = dev.ppu.dots - 456 // subtract, do not zero
        ly := dev.ram[dev.ppu.ly] + 1 // increate LY 
        if ly > 153  { ly = 0 } // wrap around
        dev.ram[dev.ppu.ly] = ly
        // If LY == 144 enable Vblank interrupt
        if ly == 144 {
            dev.ram[0xFF0F] = dev.ram[0xFF0F] | 0x01 
            dev.ppu.frame_ready = true
        }
    }
}

fn clear() {
    for y in 0..144 {
        for x in 0..160 {
            dev.framebuffer[(SCREEN_W * y + x) * 3]     = shades[0].r
            dev.framebuffer[(SCREEN_W * y + x) * 3 + 1] = shades[0].g
            dev.framebuffer[(SCREEN_W * y + x) * 3 + 2] = shades[0].b
        }
    }

}
fn draw_tile_id(base: u16, signed_ids: bool, id: u16, x: u32, y: u32) {
    // In the 0x8800 mode tile ids are signed and addressed relative to 0x9000;
    // in the 0x8000 mode they are unsigned offsets from 0x8000.
    tile_addr: u16
    if signed_ids {
        tile_addr = u16(0x9000 + i16(i8(u8(id))) * 16)
    } else {
        tile_addr = base + (id * 16)
    }
    for ty in 0..8 {
        lo := dev.ram[tile_addr + (ty * 2)]
        hi := dev.ram[tile_addr + (ty * 2) + 1]
        for tx in 0..8 {
            bit := 7 - tx
            color := (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)

            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3]     = shades[color].r
            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3 + 1] = shades[color].g
            dev.framebuffer[(SCREEN_W * (y + ty) + (x + tx)) * 3 + 2] = shades[color].b
        }
    }
}

fn draw_background() {
    scx := dev.ram[SCX_ADDR]
    scy := dev.ram[SCY_ADDR]

    for by in 0..(144 / 8) {
        for bx in 0..(160 / 8){
            tile_id := u16(dev.ram[lcd_c.bg_tile_map_base + (by * 32 + bx)])
            draw_tile_id(lcd_c.tile_data_base, lcd_c.signed_ids, tile_id, bx * 8, by * 8)
        }
    }
}

fn draw_window() {
    wx := dev.ram[0xFF4B]
    wy := dev.ram[0xFF4A]

    printf("wx = %d, wy = %d\n", wx, wy)

    for by in 0..(144 / 8) {
        for bx in 0..(160 / 8){
            tile_id := u16(dev.ram[lcd_c.window_tile_map_base + (by * 32 + bx)])
            draw_tile_id(lcd_c.tile_data_base, lcd_c.signed_ids, tile_id, bx * 8, by * 8)
        }
    }
}

fn draw() {
    reg := dev.ram[0xFF40]
    lcd_c = convert_to_lcd_control(reg)
    if !lcd_c.enabled {
        clear()
        return
    }

    draw_background()
    // draw_window()
}

struct LCDControl {
    enabled: bool
    window_tile_map_base: u16
    window_enabled: bool
    tile_data_base: u16
    signed_ids: bool // true in the 0x8800 mode: tile ids are signed, relative to 0x9000
    bg_tile_map_base: u16
    obj_size: bool // false = 8x8, true = 8 x 16 
    obj_enabled: bool
    bg_window_enabled: bool
}

lcd_c: LCDControl

fn convert_to_lcd_control(b: u8) -> LCDControl {

    res := LCDControl{}

    res.enabled = b >> 7 & 1 == 1

    if b >> 6 & 1 == 0 {
        res.window_tile_map_base = 0x9800
    } else {
        res.window_tile_map_base = 0x9c00
    }

    res.window_enabled = b >> 5 & 1 == 1

    if b >> 4 & 1 == 0 {
        res.tile_data_base = 0x8800
        res.signed_ids = true
    } else {
        res.tile_data_base = 0x8000
        res.signed_ids = false
    }

    if b >> 3 & 1 == 0 {
        res.bg_tile_map_base = 0x9800
    } else {
        res.bg_tile_map_base = 0x9c00
    }

    res.obj_size = b >> 2 & 1 == 1
    res.obj_enabled = b >> 1 & 1 == 1
    res.bg_window_enabled = b >> 0 & 1 == 1

    return res
}
