import "std:c"

struct Cart {
    pad1: [0x133]u8
    title: [10]u8
}

struct Instruction {
    execute: fn()
}

struct registers {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    flags: u8
    pc: u16
    sp: u16
}

instructions: [256]Instruction
regs: registers
buf: [32 * 1024]u8

fn create_instructions() {
    instructions[0] = Instruction{ execute = noop }
    instructions[0xc3] = Instruction{ execute = jp }
    instructions[0xaf] = Instruction{ execute = xor_a_a }
}

fn noop() {
    regs.pc = regs.pc + 1
}

fn jp() {
    pc := regs.pc
    addr: [2]u8 = [ buf[pc + 1], buf[pc + 2] ]
    regs.pc = cast(u16, addr)
}

fn xor_a_a() { 
    regs.a = 0
    regs.pc = regs.pc + 3
}

fn main() {
    create_instructions()
    regs.pc = 0x0100
    regs.sp = 0xFFFE

    rom_file := fopen("demos/gb/tetris.gb", "r")

    if rom_file == nil {
        printf("File not found!\n")
        return
    }

    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        buf[idx] = ch
        idx = idx + 1
    }

    cart := cast(Cart, buf)

    done := false
    for {
        printf("pc: %x\n", regs.pc)
        if done { break }
        pc := regs.pc
        op_code := buf[pc]
        inst := instructions[u64(op_code)]
        if inst.execute == nil {
            printf("pc: %x, opcode: %x not implemented\n", regs.pc, op_code)
            break
        }
        inst.execute()

    
        // if regs.pc == 0x150 { break }
    }
    fclose(rom_file)
}
