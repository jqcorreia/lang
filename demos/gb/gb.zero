    prefixed[0xa7] = Instruction{ execute = res_4_a, cycles = 8, mnemonic = "RES 4,A", operand_len = 0 }

    prefixed[0xa8] = Instruction{ execute = res_5_b, cycles = 8, mnemonic = "RES 5,B", operand_len = 0 }
    prefixed[0xa9] = Instruction{ execute = res_5_c, cycles = 8, mnemonic = "RES 5,C", operand_len = 0 }
    prefixed[0xaa] = Instruction{ execute = res_5_d, cycles = 8, mnemonic = "RES 5,D", operand_len = 0 }
    prefixed[0xab] = Instruction{ execute = res_5_e, cycles = 8, mnemonic = "RES 5,E", operand_len = 0 }
    prefixed[0xac] = Instruction{ execute = res_5_h, cycles = 8, mnemonic = "RES 5,H", operand_len = 0 }
    prefixed[0xad] = Instruction{ execute = res_5_l, cycles = 8, mnemonic = "RES 5,L", operand_len = 0 }
    prefixed[0xae] = Instruction{ execute = res_5_hl, cycles = 16, mnemonic = "RES 5,(HL)", operand_len = 0 }
    prefixed[0xaf] = Instruction{ execute = res_5_a, cycles = 8, mnemonic = "RES 5,A", operand_len = 0 }

    prefixed[0xb0] = Instruction{ execute = res_6_b, cycles = 8, mnemonic = "RES 6,B", operand_len = 0 }
    prefixed[0xb1] = Instruction{ execute = res_6_c, cycles = 8, mnemonic = "RES 6,C", operand_len = 0 }
    prefixed[0xb2] = Instruction{ execute = res_6_d, cycles = 8, mnemonic = "RES 6,D", operand_len = 0 }
    prefixed[0xb3] = Instruction{ execute = res_6_e, cycles = 8, mnemonic = "RES 6,E", operand_len = 0 }
    prefixed[0xb4] = Instruction{ execute = res_6_h, cycles = 8, mnemonic = "RES 6,H", operand_len = 0 }
    prefixed[0xb5] = Instruction{ execute = res_6_l, cycles = 8, mnemonic = "RES 6,L", operand_len = 0 }
    prefixed[0xb6] = Instruction{ execute = res_6_hl, cycles = 16, mnemonic = "RES 6,(HL)", operand_len = 0 }
    prefixed[0xb7] = Instruction{ execute = res_6_a, cycles = 8, mnemonic = "RES 6,A", operand_len = 0 }

    prefixed[0xb8] = Instruction{ execute = res_7_b, cycles = 8, mnemonic = "RES 7,B", operand_len = 0 }
    prefixed[0xb9] = Instruction{ execute = res_7_c, cycles = 8, mnemonic = "RES 7,C", operand_len = 0 }
    prefixed[0xba] = Instruction{ execute = res_7_d, cycles = 8, mnemonic = "RES 7,D", operand_len = 0 }
    prefixed[0xbb] = Instruction{ execute = res_7_e, cycles = 8, mnemonic = "RES 7,E", operand_len = 0 }
    prefixed[0xbc] = Instruction{ execute = res_7_h, cycles = 8, mnemonic = "RES 7,H", operand_len = 0 }
    prefixed[0xbd] = Instruction{ execute = res_7_l, cycles = 8, mnemonic = "RES 7,L", operand_len = 0 }
    prefixed[0xbe] = Instruction{ execute = res_7_hl, cycles = 16, mnemonic = "RES 7,(HL)", operand_len = 0 }
    prefixed[0xbf] = Instruction{ execute = res_7_a, cycles = 8, mnemonic = "RES 7,A", operand_len = 0 }
}

// -- ops implementations
// -------- Utils ------------
fn adv(n: u16) {
    dev.r.pc = dev.r.pc + n
}

fn set_flag(flag: Flag, val: bool) {
    mask := u8(1) << flag
    if val {
        dev.r.flags = dev.r.flags | mask
    } else {
        dev.r.flags = dev.r.flags & (0xFF ^ mask)
    }
}

fn get_flag(flag: Flag) -> bool {
    return (dev.r.flags >> flag) & 0x1 == 1
}

fn write8(addr: u16, val: u8) {
    if addr < 0x8000 {
        return // ROM region is read-only (no MBC); ignore writes
    }
    dev.ram[addr] = val
}

fn read8(addr: u16) -> u8 {
    if addr == 0xFF00 {
        // Joypad: bits are active-low (0 == pressed). The game selects a button
        // group via P14 (bit 4) / P15 (bit 5); we report the matching keys.
        sel := dev.ram[0xFF00]
        pressed: u8 = 0 // active-high here, inverted into the result below

        if (sel & 0x10) == 0 { // P14 low: direction buttons
            if IsKeyDown(i32(KeyboardKey.RIGHT)) { pressed = pressed | 0x01 }
            if IsKeyDown(i32(KeyboardKey.LEFT))  { pressed = pressed | 0x02 }
            if IsKeyDown(i32(KeyboardKey.UP))    { pressed = pressed | 0x04 }
            if IsKeyDown(i32(KeyboardKey.DOWN))  { pressed = pressed | 0x08 }
        }
        if (sel & 0x20) == 0 { // P15 low: action buttons
            if IsKeyDown(i32(KeyboardKey.Z))         { pressed = pressed | 0x01 } // A
            if IsKeyDown(i32(KeyboardKey.X))         { pressed = pressed | 0x02 } // B
            if IsKeyDown(i32(KeyboardKey.BACKSPACE)) { pressed = pressed | 0x04 } // Select
            if IsKeyDown(i32(KeyboardKey.ENTER))     { pressed = pressed | 0x08 } // Start
        }

        // Keep the select bits, force unused bits 6-7 high, invert button bits.
        return (sel & 0x30) | 0xC0 | (0x0F ^ pressed)
    }
    return dev.ram[addr]
}

fn push16(val: u16) {
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val >> 8))
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val & 0xFF))
}

fn pop16() -> u16 {
    low := u16(read8(dev.r.sp))
    dev.r.sp = dev.r.sp + 1
    high := u16(read8(dev.r.sp))
    dev.r.sp = dev.r.sp + 1

    return (high << 8) | low
}

fn read_hl() -> u16 {
    return u16(dev.r.h) << 8 | u16(dev.r.l)
}

fn write_bc(val: u16)  {
    dev.r.b = u8(val >> 8)
    dev.r.c = u8(val & 0xFF)
}

fn write_de(val: u16)  {
    dev.r.d = u8(val >> 8)
    dev.r.e = u8(val & 0xFF)
}

fn write_hl(val: u16)  {
    dev.r.h = u8(val >> 8)
    dev.r.l = u8(val & 0xFF)
}

fn write_af(val: u16)  {
    dev.r.a = u8(val >> 8)
    dev.r.flags = u8(val & 0xFF)
}

fn read_bc() -> u16 {
    return u16(dev.r.b) << 8 | u16(dev.r.c)
}

fn read_de() -> u16 {
    return u16(dev.r.d) << 8 | u16(dev.r.e)
}
fn read_af() -> u16 {
    return u16(dev.r.a) << 8 | u16(dev.r.flags)
}

fn h_flag_sub(v1: u8, v2: u8) -> bool {
    return (v1 & 0x0F) < (v2 & 0x0F)
}

fn h_flag_add(v1: u8, v2: u8) -> bool {
    return (v1 & 0x0F) + (v2 & 0x0F) > 0x0F
}

fn interrupt(vector: IRQ_Vector) {
    dev.ram[0xFF0F] = dev.ram[0xFF0F] & 0xFE 
    push16(dev.r.pc)
    dev.ime = false
    dev.r.pc = vector 
}

// Print the instruction at pc using its mnemonic format string. Read-only: does
// not advance pc. Pass the opcode address (pc, or pc+1 for CB-prefixed ops).
fn disasm(pc: u16, inst: Instruction) {
    if inst.execute == null {
        printf("$%02X (unimplemented)\n", dev.ram[pc])
        return
    }
    printf("%04x ", pc)
    if inst.operand_len == 1 {
        printf(inst.mnemonic, dev.ram[pc + 1])
    } else {
        if inst.operand_len == 2 {
            lo := u16(dev.ram[pc + 1])
            hi := u16(dev.ram[pc + 2])
            printf(inst.mnemonic, lo | (hi << 8)) // GB immediates are little-endian
        } else {
            printf(inst.mnemonic)
        }
    }
    printf("\n")
}

fn run_single_instruction() -> bool {
    pending := false

    if dev.ime && (dev.ram[0xFFFF] & dev.ram[0xFF0F] & 0x01) != 0 {
        interrupt(.VBlank)
    }
    
    prefix := false
    op_code := dev.ram[dev.r.pc]

    inst: Instruction
    if op_code == 0xcb {
        op_code = dev.ram[dev.r.pc + 1]
        inst = prefixed[u64(op_code)]
        prefix = true
    } else {
        inst = instructions[u64(op_code)]
    }
    // disasm(dev.r.pc, inst)
    if inst.execute == null {
        printf("pc: %x, opcode: %x (prefixed=%b) not implemented\n", dev.r.pc, op_code, prefix)
        return false
    }

    inst.execute()
    dev.cycles = dev.cycles + u64(inst.cycles)

    ppu_tick(inst.cycles)

    return true
}

fn run_until_vblank() -> bool {
    dev.ppu.frame_ready = false
    for {
        if !run_single_instruction() { return false }
        if dev.ppu.frame_ready { break }
    }
    return true
}

fn load_rom(file: cstr) -> &FILE {
    rom_file := fopen(file, "r")

    if rom_file == null {
        printf("File not found!\n")
        return null
    }

    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        dev.ram[idx] = ch
        idx = idx + 1
    }
    return rom_file
}

fn main() {
    init_dev()

    InitWindow(SCREEN_W * 4, SCREEN_H * 4, "Zero GB")
    rom_file := load_rom("demos/gb/tetris.gb")
    if rom_file == null {
        exit(1)
    }

    img := Image{
        data = &dev.framebuffer[0],
        width = SCREEN_W,
        height = SCREEN_H,
        mipmaps = 1,
        format = i32(PixelFormat.UNCOMPRESSED_R8G8B8),
    }

    fb_tex := LoadTextureFromImage(img)

    for !WindowShouldClose(){
        // run_until_vblank()
        if !run_until_vblank() {
            break
        }

        draw_background()

        UpdateTexture(fb_tex, &dev.framebuffer[0])

        BeginDrawing()
        ClearBackground(shades[0])
        src := Rectangle{0, 0, f32(SCREEN_W), f32(SCREEN_H)}
        dst := Rectangle{0, 0, f32(GetScreenWidth()), f32(GetScreenHeight())}
        DrawTexturePro(fb_tex, src, dst, Vector2{0, 0}, 0, Color{255, 255, 255, 255})
        EndDrawing()
     }


    fclose(rom_file)
    printf("cycles executed: %d\n", dev.cycles )
}
