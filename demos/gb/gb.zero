import "std:c"

struct Cart {
    pad1: [0x133]u8
    title: [10]u8
}

struct Instruction {

}

struct registers {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    flags: u8
    pc: u16
    sp: u16
}

instructions: [256]Instruction
regs: registers

fn create_instructions() {
    instructions[0] = Instruction{}
}

fn main() {
    create_instructions()
    regs.pc = 0x100

    rom_file := fopen("demos/gb/tetris.gb", "r")

    if rom_file == nil {
        printf("File not found!\n")
        return
    }

    buf: [32 * 1024]u8
    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        buf[idx] = ch
        idx = idx + 1
    }

    cart := cast(Cart, buf)

    done := false
    for {
        if done { break }
        pc := u64(regs.pc)
        op_code := buf[pc]

        match op_code {
            0x00 => {
                regs.pc = regs.pc + 1
            }
            0x50 => {
                regs.pc = buf[pc + 1]
            }
        }
    }
    fclose(rom_file)
}
