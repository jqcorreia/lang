import "std:c"

struct Instruction {
    execute: fn()
}

struct registers {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    f: u8
    h: u8
    l: u8
    flags: u8
    pc: u16
    sp: u16
}

struct Dev {
    r: registers
    rom: [32 * 1024]u8
    ram: [64 * 1024]u8
}

dev: Dev
instructions: [256]Instruction

fn create_instructions() {
    instructions[0x00] = Instruction{ execute = noop }
    instructions[0xc3] = Instruction{ execute = jp }

    instructions[0xaf] = Instruction{ execute = xor_a_a }

    instructions[0xdf] = Instruction{ execute = rst }
    instructions[0xff] = Instruction{ execute = rst }

    instructions[0x21] = Instruction{ execute = load_hl }

    instructions[0x0E] = Instruction{ execute = load_c }
    instructions[0x06] = Instruction{ execute = load_b }
}

fn noop() {
    dev.r.pc = dev.r.pc + 1
}

fn jp() {
    pc := u64(dev.r.pc)
    addr := dev.rom[pc+1:pc+2]
    printf("b1 %x b2 %x\n", dev.rom[pc+1], dev.rom[pc+2])
    printf("jmp to %0x \n", cast(u16, addr))
    dev.r.pc = cast(u16, addr)
}

fn xor_a_a() { 
    dev.r.a = 0
    dev.r.pc = dev.r.pc + 1
}

fn rst() {
    opcode := dev.rom[dev.r.pc]
    push16(dev.r.pc)
    dev.r.pc = u16(opcode & 0x38) // Formula to calculate the reset vector
}

fn load_hl() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.rom[pc+1:pc+2])
    dev.r.h = u8(val >> 8)
    dev.r.l = u8(val & 0xFF)
    dev.r.pc = dev.r.pc + 3
}

fn load_b() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc]
    dev.r.b = val
    dev.r.pc = dev.r.pc + 2
}

fn load_c() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc]
    dev.r.c = val
    dev.r.pc = dev.r.pc + 2
}

fn write8(addr: u16, val: u8) {
    dev.ram[addr] = val 
}

fn push16(val: u16) {
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val >> 8))
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val & 0xFF))
}

fn main() {
    create_instructions()
    dev.r.pc = 0x0100
    dev.r.sp = 0xFFFE
    dev.r.a = 0x01
    dev.r.f = 0xb0

    rom_file := fopen("demos/gb/tetris.gb", "r")

    if rom_file == null {
        printf("File not found!\n")
        return
    }

    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        dev.rom[idx] = ch
        idx = idx + 1
    }

    done := false
    for {
        printf("pc: %x\n", dev.r.pc)
        if done { break }
        pc := dev.r.pc
        op_code := dev.rom[pc]
        inst := instructions[u64(op_code)]
        if inst.execute == null {
            printf("pc: %x, opcode: %x not implemented\n", dev.r.pc, op_code)
            break
        }
        inst.execute()
    }
    fclose(rom_file)
}
