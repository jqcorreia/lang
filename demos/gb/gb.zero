import "std:c"

struct Instruction {
    execute: fn()
}

struct registers {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    flags: u8
    pc: u16
    sp: u16
}

struct Dev {
    r: registers
    rom: [32 * 1024]u8
    ram: [32 * 1024]u8
}

dev: Dev
instructions: [256]Instruction

fn create_instructions() {
    instructions[0] = Instruction{ execute = noop }
    instructions[0xc3] = Instruction{ execute = jp }
    instructions[0xaf] = Instruction{ execute = xor_a_a }
}

fn noop() {
    dev.r.pc = dev.r.pc + 1
}

fn jp() {
    pc := u64(dev.r.pc)
    addr := dev.rom[pc+1:pc+2]
    dev.r.pc = cast(u16, addr)
}

fn xor_a_a() { 
    dev.r.a = 0
    dev.r.pc = dev.r.pc + 3
}

fn rst(addr: u16) {
    
}
fn main() {
    create_instructions()
    dev.r.pc = 0x0100
    dev.r.sp = 0xFFFE

    rom_file := fopen("demos/gb/tetris.gb", "r")

    if rom_file == null {
        printf("File not found!\n")
        return
    }

    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        dev.rom[idx] = ch
        idx = idx + 1
    }

    done := false
    for {
        printf("pc: %x\n", dev.r.pc)
        if done { break }
        pc := dev.r.pc
        op_code := dev.rom[pc]
        inst := instructions[u64(op_code)]
        if inst.execute == null {
            printf("pc: %x, opcode: %x not implemented\n", dev.r.pc, op_code)
            break
        }
        inst.execute()

    
        // if dev.r.pc == 0x150 { break }
    }
    fclose(rom_file)
}
