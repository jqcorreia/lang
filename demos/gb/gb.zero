import "std:c"

struct Instruction {
    execute: fn()
}

struct registers {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    flags: u8
    pc: u16
    sp: u16
}

struct Dev {
    r: registers
    rom: [32 * 1024]u8
    ram: [64 * 1024]u8
    ime: bool // IME == Interrupt Master Enable
    ppu: PPU
}

struct PPU {
    ly: u16
}

enum Flag {
    Zero = 7
    Subtract = 6
    HalfCarry = 5
    Carry = 4
}

dev: Dev
instructions: [256]Instruction
prefixed: [256]Instruction


fn init_dev() {
    dev.r.pc = 0x0100
    dev.r.sp = 0xFFFE
    dev.r.a = 0x01
    dev.r.b = 0x00
    dev.r.c = 0x13
    dev.r.d = 0x00
    dev.r.e = 0xd8
    dev.r.h = 0x01
    dev.r.l = 0x4d

    dev.r.flags = 0xb0

    dev.ppu.ly = 0xFF44

    instructions[0x00] = Instruction{ execute = noop }
    instructions[0x20] = Instruction{ execute = jr_nz }
    instructions[0xc3] = Instruction{ execute = jp }

    instructions[0xaf] = Instruction{ execute = xor_a_a }

    instructions[0x0c] = Instruction{ execute = inc_c }
    instructions[0x05] = Instruction{ execute = dec_b }
    instructions[0x0d] = Instruction{ execute = dec_c }
    instructions[0x0b] = Instruction{ execute = dec_bc }

    instructions[0xdf] = Instruction{ execute = rst }
    instructions[0xff] = Instruction{ execute = rst }

    instructions[0x21] = Instruction{ execute = load_hl }
    instructions[0x32] = Instruction{ execute = ldd_hl_a }
    instructions[0x2a] = Instruction{ execute = ldi_a_hl }
    instructions[0x36] = Instruction{ execute = ld_hl_n8 }
    instructions[0xea] = Instruction{ execute = ld_a16_a }

    instructions[0xE0] = Instruction{ execute = ldh_a8_a }
    instructions[0xF0] = Instruction{ execute = ldh_a_a8 }
    instructions[0xE2] = Instruction{ execute = ldh_c_a }

    instructions[0x78] = Instruction{ execute = ld_a_b }

    instructions[0x3e] = Instruction{ execute = ld_a_n8 }
    instructions[0x06] = Instruction{ execute = ld_b_n8 }
    instructions[0x0E] = Instruction{ execute = ld_c_n8 }

    instructions[0x01] = Instruction{ execute = ld_bc_n16 }
    instructions[0x31] = Instruction{ execute = ld_sp_n16 }

    instructions[0xFE] = Instruction{ execute = cp_a_n8 }
    instructions[0xB1] = Instruction{ execute = or_a_c }

    instructions[0xe6] = Instruction{ execute = push_hl }
    instructions[0x2F] = Instruction{ execute = cpl }
    instructions[0x0F] = Instruction{ execute = rrca }

    instructions[0xCD] = Instruction{ execute = call_a16 }
    instructions[0xC9] = Instruction{ execute = ret }

    instructions[0xF3] = Instruction{ execute = di }
    instructions[0xFB] = Instruction{ execute = ei }

    prefixed[0x00] = Instruction{ execute = null }
}

// -- ops implementations

fn noop() {
    adv(1)
}

fn jp() {
    pc := u64(dev.r.pc)
    addr := dev.rom[pc+1:pc+2]
    dev.r.pc = cast(u16, addr)
}

fn jr_nz() {
    o := dev.r.pc
    r := i16(i8(dev.rom[dev.r.pc + 1]))

    // abort()

     // Since we need to jump from the next instruction,
    // advance unconditionally
    adv(2)
    if !get_flag(.Zero) {
        dev.r.pc = u16(i16(dev.r.pc) + r)  
    }
}

fn xor_a_a() { 
    dev.r.a = 0
    adv(1)
}

fn inc_c() {
    h_flag := dev.r.b & 0x0F == 0x0F
    c_flag := dev.r.b == 0xFF 

    dev.r.c = dev.r.c + 1
    set_flag(.Zero, dev.r.c == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    adv(1)
}

fn dec_reg(r: &u8) {
    h_flag := false
    if (*r & 0x0F) == 0 {
        h_flag = true
    }

    *r = *r - 1
    set_flag(.Zero, *r == 0)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag) 

    adv(1)
}

fn dec_b() {
    dec_reg(&(dev.r.b))
}

fn dec_c() {
    dec_reg(&(dev.r.c))
}

fn dec_bc() {
    write_bc(read_bc() - 1)
    adv(1)
}

fn cpl() {
    dev.r.a = ~dev.r.a
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, true)
    adv(1)
}
fn rst() {
    opcode := dev.rom[dev.r.pc]
    push16(dev.r.pc + 1) // return address = instruction after RST
    dev.r.pc = u16(opcode & 0x38) // Formula to calculate the reset vector
}

fn ld_a_b() {
    dev.r.a = dev.r.b
    adv(1)
}

fn load_hl() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.rom[pc+1:pc+2])
    dev.r.h = u8(val >> 8)
    dev.r.l = u8(val & 0xFF)
    adv(3)
}

fn ldd_hl_a() {
    dev.ram[read_hl()] = dev.r.a
    write_hl(read_hl() - 1)
    adv(1)
}

fn ldi_a_hl() {
    hl := read_hl()

    dev.r.a = dev.ram[hl]

    write_hl(hl + 1)
    adv(1)
}

fn ld_hl_n8() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc + 1]
    dev.ram[read_hl()] = val
    adv(2)
}

fn ld_a_n8() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc + 1]
    dev.r.a = val
    adv(2)
}

fn ld_b_n8() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc + 1]
    dev.r.b = val
    adv(2)
}

fn ld_c_n8() {
    pc := u64(dev.r.pc)
    val := dev.rom[pc + 1]
    dev.r.c = val
    adv(2)
}

fn ldh_a8_a() {
    pc := u64(dev.r.pc)
    offset := dev.rom[pc + 1]
    dev.ram[0xFF00 + u16(offset)] = dev.r.a
    adv(2)
}

fn ldh_a_a8() {
    pc := u64(dev.r.pc)
    offset := dev.rom[pc + 1]
    dev.r.a = dev.ram[0xFF00 + u16(offset)]
    adv(2)
}

fn ldh_c_a() {
    dev.ram[0xFF00 + dev.r.c] = dev.r.a
    adv(1)
}

fn ld_a16_a() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.rom[pc+1:pc+2])
    dev.ram[val] = dev.r.a

    adv(3)
}

fn ld_sp_n16() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.rom[pc+1:pc+2])
    dev.r.sp = val

    adv(3)
}
fn ld_bc_n16() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.rom[pc+1:pc+2])

    write_bc(val)
    adv(3)
}

fn cp_a_n8() {
    pc := u64(dev.r.pc)
    im := dev.rom[pc + 1]
    val := dev.r.a

    set_flag(.Zero, im == val)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag_sub(val, im))
    set_flag(.Carry, val < im)

    adv(2)
}

fn or_a_c() {
    dev.r.a = dev.r.a | dev.r.c
    set_flag(.Zero, dev.r.a == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, false)

    adv(1)
}

fn push_hl() {
    push16(read_hl())
    adv(1)
}

fn rrca() {
    c_flag := dev.r.a & 0x01 == 1
    dev.r.a = dev.r.a >> 1

    set_flag(.Zero, dev.r.a == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(1)
}

fn ret() {
    addr := pop16()
    dev.r.pc = addr
}

fn call_a16() {
    pc := u64(dev.r.pc)
    target_addr := cast(u16, dev.rom[pc+1:pc+2])

    push16(u16(pc) + 3) // return address = instruction after CALL
    dev.r.pc = target_addr
}

fn ei() {
    dev.ime = true
    adv(1)
}

fn di() {
    dev.ime = false
    adv(1)
}


// -------- Utils ------------
fn adv(n: u16) {
    dev.r.pc = dev.r.pc + n
}

fn set_flag(flag: Flag, val: bool) {
    mask := u8(1) << flag
    if val {
        dev.r.flags = dev.r.flags | mask
    } else {
        dev.r.flags = dev.r.flags & (0xFF ^ mask)
    }
}

fn get_flag(flag: Flag) -> bool {
    return (dev.r.flags >> flag) & 0x1 == 1
}

fn write8(addr: u16, val: u8) {
    dev.ram[addr] = val 
}

fn read8(addr: u16) -> u8 {
    return dev.ram[addr]
}

fn push16(val: u16) {
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val >> 8))
    dev.r.sp = dev.r.sp - 1
    write8(dev.r.sp, u8(val & 0xFF))
}

fn pop16() -> u16 {
    low := u16(read8(dev.r.sp))
    dev.r.sp = dev.r.sp + 1
    high := u16(read8(dev.r.sp))
    dev.r.sp = dev.r.sp + 1

    return (high << 8) | low
}

fn read_hl() -> u16 {
    return u16(dev.r.h) << 8 | u16(dev.r.l)
}

fn write_hl(val: u16)  {
    dev.r.h = u8(val >> 8)
    dev.r.l = u8(val & 0xFF)
}

fn read_bc() -> u16 {
    return u16(dev.r.b) << 8 | u16(dev.r.c)
}

fn write_bc(val: u16)  {
    dev.r.b = u8(val >> 8)
    dev.r.c = u8(val & 0xFF)
}

fn h_flag_sub(v1: u8, v2: u8) -> bool {
    return (v1 & 0x0F) < (v2 & 0x0F)
}
fn main() {
    ops_done := 0

    init_dev()

    rom_file := fopen("demos/gb/tetris.gb", "r")

    if rom_file == null {
        printf("File not found!\n")
        return
    }

    ch: u8
    idx := 0
    for {
        nb := fread(&ch, 1, 1, rom_file)
        if nb == 0 {
            break
        }
        dev.rom[idx] = ch
        idx = idx + 1
    }

    done := false
    for {
        prefix := false
        if done { break }

        op_code := dev.rom[dev.r.pc]

        inst: Instruction
        if op_code == 0xcb {
            dev.r.pc = dev.r.pc + 1
            op_code = dev.rom[dev.r.pc]
            inst = prefixed[u64(op_code)]
            prefix = true
        } else {
            inst = instructions[u64(op_code)]
        }
        // printf("pc: %x, opcode %x\n", dev.r.pc, op_code)
        if inst.execute == null {
            printf("pc: %x, opcode: %x (prefixed=%b) not implemented\n", dev.r.pc, op_code, prefix)
            break
        }
        inst.execute()
        ops_done = ops_done + 1

        // Increment LY per cycle, dumb and wrong
        dev.ram[dev.ppu.ly] = dev.ram[dev.ppu.ly] + 1 
    }
    fclose(rom_file)
    printf("Total ops executed %d\n", ops_done)
}
