fn ccf() {
    c_flag := get_flag(.Carry)
    set_flag(.Zero, false)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, !c_flag)
    adv(1)
}

fn rrca() {
    c_flag := dev.r.a & 0x01 == 1
    dev.r.a = dev.r.a >> 1

    set_flag(.Zero, dev.r.a == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(1)
}

fn ret() {
    addr := pop16()
    dev.r.pc = addr
}

fn ret_z() {
    if get_flag(.Zero) {
        dev.r.pc = pop16()
    } else {
        adv(1)
    }
}

fn ret_nz() {
    if !get_flag(.Zero) {
        dev.r.pc = pop16()
    } else {
        adv(1)
    }
}

fn reti() {
    ret()
    dev.ime = true
}

fn call_nc_a16() {
    if get_flag(.Carry) {
        adv(3)
    } else {
        pc := u64(dev.r.pc)
        target_addr := cast(u16, dev.ram[pc+1:pc+2])

        printf("target addr %x\n", target_addr)
        push16(u16(pc) + 3) // return address = instruction after CALL
        dev.r.pc = target_addr
    }
}

fn call_a16() {
    pc := u64(dev.r.pc)
    target_addr := cast(u16, dev.ram[pc+1:pc+2])

    push16(u16(pc) + 3) // return address = instruction after CALL
    dev.r.pc = target_addr
}


fn swap_a() { swap_8(&dev.r.a) }
fn swap_b() { swap_8(&dev.r.b) }
fn swap_c() { swap_8(&dev.r.c) }
fn swap_d() { swap_8(&dev.r.d) }
fn swap_e() { swap_8(&dev.r.e) }

fn swap_8(reg: &u8) {
    v := *reg

    nv := ((v >> 4) & 0x0F) + ((v << 4) & 0xF0)

    *reg = nv

    set_flag(.Zero, nv == 0)
    set_flag(.Subtract, false)
    set_flag(.Carry, false)
    set_flag(.HalfCarry, false)
    adv(2)
}

fn sla_a() { sla_8(&dev.r.a) }

fn sla_8(reg: &u8) {
    v := *reg
    c_flag := (v & 0x80) != 0
    nv := v << 1 // bit 0 becomes 0, old bit 7 goes to carry

    *reg = nv

    set_flag(.Zero, nv == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(2)
}

fn sra_a() { sra_8(&dev.r.a) }

fn sra_8(reg: &u8) {
    v := *reg
    c_flag := (v & 0x01) != 0
    nv := (v >> 1) | (v & 0x80) // bit 0 goes to carry, bit 7 (sign) is preserved

    *reg = nv

    set_flag(.Zero, nv == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(2)
}

fn srl_a() { srl_8(&dev.r.a) }

fn srl_8(reg: &u8) {
    v := *reg
    c_flag := (v & 0x01) != 0
    nv := v >> 1 // bit 0 goes to carry, bit 7 becomes 0

    *reg = nv

    set_flag(.Zero, nv == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(2)
}

fn bit_reg(bit: u8, r: &u8) {
    set_flag(.Zero, (*r >> bit) & 0x1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true)
    adv(2)
}

fn bit_ind_hl(bit: u8) {
    set_flag(.Zero, (dev.ram[read_hl()] >> bit) & 0x1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true)
    adv(2)
}

fn bit_0_b() { bit_reg(0, &dev.r.b) }
