fn noop() {
    adv(1)
}

fn jp() {
    pc := u64(dev.r.pc)
    addr := dev.ram[pc+1:pc+2]
    dev.r.pc = cast(u16, addr)
}

fn jp_z() {
    pc := u64(dev.r.pc)
    addr := dev.ram[pc+1:pc+2]

    if get_flag(.Zero) {
        dev.r.pc = cast(u16, addr)
    } else {
        adv(3)
    }
}

fn jp_hl() {
    dev.r.pc = read_hl() // JP HL sets PC directly; no adv()
}

fn jr() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

    adv(2)
    dev.r.pc = u16(i16(dev.r.pc) + r)  
}

fn jr_z() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

     // Since we need to jump from the next instruction,
    // advance unconditionally
    adv(2)
    if get_flag(.Zero) {
        dev.r.pc = u16(i16(dev.r.pc) + r)  
    }
}

fn jr_nz() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

     // Since we need to jump from the next instruction,
    // advance unconditionally
    adv(2)
    if !get_flag(.Zero) {
        dev.r.pc = u16(i16(dev.r.pc) + r)  
    }
}

fn xor_a_a() { 
    dev.r.a = 0
    adv(1)
}

fn inc_reg(r: &u8) {
    h_flag := *r & 0x0F == 0x0F
    c_flag := *r == 0xFF 

    *r = *r + 1
    set_flag(.Zero, *r == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    adv(1)
}

fn inc_a() {
    inc_reg(&dev.r.a)
}

fn inc_b() {
    inc_reg(&dev.r.b)
}

fn inc_c() {
    inc_reg(&dev.r.c)
}

fn inc_d() {
    inc_reg(&dev.r.d)
}

fn inc_e() {
    inc_reg(&dev.r.e)
}

fn inc_l() {
    inc_reg(&dev.r.l)
}

fn inc_hl() {
    write_hl(read_hl() + 1)

    adv(1)
}

fn inc_ind_hl() {
    val := dev.ram[read_hl()] 
    h_flag := val & 0x0F == 0x0F
    dev.ram[read_hl()] = val + 1 

    set_flag(.Zero, val == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag) 
    adv(1)
}

fn dec_reg(r: &u8) {
    h_flag := false
    if (*r & 0x0F) == 0 {
        h_flag = true
    }

    *r = *r - 1
    set_flag(.Zero, *r == 0)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag) 

    adv(1)
}

fn dec_a() {
    dec_reg(&(dev.r.a))
}

fn dec_b() {
    dec_reg(&(dev.r.b))
}

fn dec_c() {
    dec_reg(&(dev.r.c))
}

fn dec_bc() {
    write_bc(read_bc() - 1)
    adv(1)
}

fn cpl() {
    dev.r.a = ~dev.r.a
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, true)
    adv(1)
}
fn rst() {
    opcode := dev.ram[dev.r.pc]
    push16(dev.r.pc + 1) // return address = instruction after RST
    dev.r.pc = u16(opcode & 0x38) // Formula to calculate the reset vector
}

fn ld_a_b() {
    dev.r.a = dev.r.b
    adv(1)
}

fn ld_b_a() {
    dev.r.b = dev.r.a
    adv(1)
}

fn ld_c_a() {
    dev.r.c = dev.r.a
    adv(1)
}

fn ld_e_a() {
    dev.r.e = dev.r.a
    adv(1)
}

fn ld_a_c() {
    dev.r.a = dev.r.c
    adv(1)
}

fn ld_a_de() {
    dev.r.a = dev.ram[read_de()]
    adv(1)
}

fn ld_a_hl() {
    dev.r.a = dev.ram[read_hl()]
    adv(1)
}

fn ld_c_hl() {
    dev.r.c = dev.ram[read_hl()]
    adv(1)
}
fn ld_d_hl() {
    dev.r.d = dev.ram[read_hl()]
    adv(1)
}
fn ld_e_hl() {
    dev.r.e = dev.ram[read_hl()]
    adv(1)
}

fn load_hl() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.ram[pc+1:pc+2])
    dev.r.h = u8(val >> 8)
    dev.r.l = u8(val & 0xFF)
    adv(3)
}

fn ldd_hl_a() {
    dev.ram[read_hl()] = dev.r.a
    write_hl(read_hl() - 1)
    adv(1)
}

fn ldi_a_hl() {
    hl := read_hl()

    dev.r.a = dev.ram[hl]

    write_hl(hl + 1)
    adv(1)
}

fn ld_hl_n8() {
    pc := u64(dev.r.pc)
    val := dev.ram[pc + 1]
    dev.ram[read_hl()] = val
    adv(2)
}

fn ld_a_n8() {
    pc := u64(dev.r.pc)
    val := dev.ram[pc + 1]
    dev.r.a = val
    adv(2)
}

fn ld_b_n8() {
    pc := u64(dev.r.pc)
    val := dev.ram[pc + 1]
    dev.r.b = val
