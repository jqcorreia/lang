fn noop() {
    adv(1)
}

fn jp() {
    pc := u64(dev.r.pc)
    addr := dev.ram[pc+1:pc+2]
    dev.r.pc = cast(u16, addr)
}

fn jp_z() {
    pc := u64(dev.r.pc)
    addr := dev.ram[pc+1:pc+2]

    if get_flag(.Zero) {
        dev.r.pc = cast(u16, addr)
    } else {
        adv(3)
    }
}

fn jp_nz() {
    pc := u64(dev.r.pc)
    addr := dev.ram[pc+1:pc+2]

    if !get_flag(.Zero) {
        dev.r.pc = cast(u16, addr)
    } else {
        adv(3)
    }
}

fn jp_hl() {
    dev.r.pc = read_hl() // JP HL sets PC directly; no adv()
}

fn jr() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

    adv(2)
    dev.r.pc = u16(i16(dev.r.pc) + r)  
}

fn jr_z() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

     // Since we need to jump from the next instruction,
    // advance unconditionally
    adv(2)
    if get_flag(.Zero) {
        dev.r.pc = u16(i16(dev.r.pc) + r)  
    }
}

fn jr_nz() {
    o := dev.r.pc
    r := i16(i8(dev.ram[dev.r.pc + 1]))

     // Since we need to jump from the next instruction,
    // advance unconditionally
    adv(2)
    if !get_flag(.Zero) {
        dev.r.pc = u16(i16(dev.r.pc) + r)  
    }
}

fn xor_a_a() { 
    dev.r.a = 0
    adv(1)
}

fn inc_reg(r: &u8) {
    h_flag := *r & 0x0F == 0x0F
    c_flag := *r == 0xFF 

    *r = *r + 1
    set_flag(.Zero, *r == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    adv(1)
}

fn inc_a() {
    inc_reg(&dev.r.a)
}

fn inc_b() {
    inc_reg(&dev.r.b)
}

fn inc_c() {
    inc_reg(&dev.r.c)
}

fn inc_d() {
    inc_reg(&dev.r.d)
}

fn inc_e() {
    inc_reg(&dev.r.e)
}

fn inc_l() {
    inc_reg(&dev.r.l)
}

fn inc_hl() {
    write_hl(read_hl() + 1)

    adv(1)
}

fn inc_ind_hl() {
    val := dev.ram[read_hl()] 
    h_flag := val & 0x0F == 0x0F
    dev.ram[read_hl()] = val + 1 

    set_flag(.Zero, val + 1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag) 
    adv(1)
}

fn dec_ind_hl() {
    val := dev.ram[read_hl()] 
    h_flag := (val & 0x0F) == 0
    dev.ram[read_hl()] = val - 1 

    set_flag(.Zero, val - 1 == 0)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag) 
    adv(1)
}

fn dec_reg(r: &u8) {
    h_flag := false
    if (*r & 0x0F) == 0 {
        h_flag = true
    }

    *r = *r - 1
    set_flag(.Zero, *r == 0)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag) 

    adv(1)
}

fn dec_a() {
    dec_reg(&(dev.r.a))
}

fn dec_b() {
    dec_reg(&(dev.r.b))
}

fn dec_c() {
    dec_reg(&(dev.r.c))
}
fn dec_l() {
    dec_reg(&(dev.r.l))
}

fn dec_bc() {
    write_bc(read_bc() - 1)
    adv(1)
}

fn dec_hl() {
    write_hl(read_hl() - 1)
    adv(1)
}

fn cpl() {
    dev.r.a = ~dev.r.a
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, true)
    adv(1)
}

// DAA: adjust A into valid BCD using the flags left by the previous add/sub.
fn daa() {
    correction := u8(0)
    set_carry := false

    // Low nibble overflowed (or a half-borrow happened): fix the low digit.
    if get_flag(.HalfCarry) || (!get_flag(.Subtract) && (dev.r.a & 0x0F) > 0x09) {
        correction = correction | 0x06
    }
    // High nibble overflowed (or a full borrow happened): fix the high digit.
    if get_flag(.Carry) || (!get_flag(.Subtract) && dev.r.a > 0x99) {
        correction = correction | 0x60
        set_carry = true // carry stays set on subtraction, gets set on addition overflow
    }

    if get_flag(.Subtract) {
        dev.r.a = dev.r.a - correction
    } else {
        dev.r.a = dev.r.a + correction
    }

    set_flag(.Zero, dev.r.a == 0)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, set_carry)
    adv(1)
}
fn rst() {
    opcode := dev.ram[dev.r.pc]
    push16(dev.r.pc + 1) // return address = instruction after RST
    dev.r.pc = u16(opcode & 0x38) // Formula to calculate the reset vector
}

