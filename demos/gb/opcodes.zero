    adv(2)
}

fn ldh_a8_a() {
    pc := u64(dev.r.pc)
    offset := dev.ram[pc + 1]
    dev.ram[0xFF00 + u16(offset)] = dev.r.a
    adv(2)
}

fn ldh_a_a8() {
    pc := u64(dev.r.pc)
    offset := dev.ram[pc + 1]
    dev.r.a = read8(0xFF00 + u16(offset))
    adv(2)
}

fn ldh_c_a() {
    dev.ram[0xFF00 + u16(dev.r.c)] = dev.r.a
    adv(1)
}

fn ld_a16_a() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.ram[pc+1:pc+2])
    dev.ram[val] = dev.r.a

    adv(3)
}

fn ld_a_a16() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.ram[pc+1:pc+2])
    dev.r.a = read8(val)

    adv(3)
}

fn ld_sp_n16() {
    pc := u64(dev.r.pc)
    val := cast(u16, dev.ram[pc+1:pc+2])
    dev.r.sp = val

    adv(3)
