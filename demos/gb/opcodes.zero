fn ld_bc_a() {
    dev.ram[read_bc()] = dev.r.a
    adv(1)

}

fn ld_de_a() {
    dev.ram[read_de()] = dev.r.a
    adv(1)
}

fn inc_de() {
    write_de(read_de() + 1)
    adv(1)
}

fn cp_a_n8() {
    pc := u64(dev.r.pc)
    im := dev.ram[pc + 1]
    val := dev.r.a

    set_flag(.Zero, im == val)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag_sub(val, im))
    set_flag(.Carry, val < im)

    adv(2)
}

fn add_r1_r2(r1: &u8, r2: &u8) {
    c_flag := *r1 + *r2 > 0xFF 
    h_flag := h_flag_add(*r1, *r2)

    *r1 = *r1 + *r2

    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    set_flag(.Carry, c_flag)

    adv(1)
}

fn or_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 | *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, false)

    adv(1)
}

fn xor_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 ^ *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, false)

    adv(1)
}

fn and_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 & *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true) // Halfcarry is true in case of AND
    set_flag(.Carry, false)

    adv(1)
}

fn and_r1_n8(r1: &u8) {
    val := dev.ram[dev.r.pc + 1]
    *r1 = *r1 & val
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true) // Halfcarry is true in case of AND
    set_flag(.Carry, false)

    adv(2)
}

fn add_a_a() {
    add_r1_r2(&dev.r.a, &dev.r.a)
}

fn add_hl_de() {
    hl := read_hl()
    de := read_de()
    sum := u32(hl) + u32(de)

    set_flag(.Subtract, false)
    set_flag(.HalfCarry, (hl & 0x0FFF) + (de & 0x0FFF) > 0x0FFF)
    set_flag(.Carry, sum > 0xFFFF)

    write_hl(u16(sum))
    adv(1)
}

fn or_a_c() {
   or_r1_r2(&dev.r.a, &dev.r.c)
}

fn or_a_b() {
    or_r1_r2(&dev.r.a, &dev.r.b)
}

fn and_a_a() {
   and_r1_r2(&dev.r.a, &dev.r.a)
}

fn and_a_c() {
   and_r1_r2(&dev.r.a, &dev.r.c)
}

fn and_a_n8() {
   and_r1_n8(&dev.r.a)
}

fn and_a_hl() {
    and_r1_hl(&dev.r.a)
}

fn and_r1_hl(r1: &u8) {
    val := dev.ram[read_hl()]
    *r1 = *r1 & val
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true) // Halfcarry is true in case of AND
    set_flag(.Carry, false)

    adv(2)
}

fn xor_a_c() {
    xor_r1_r2(&dev.r.a, &dev.r.c)
}

fn push_hl() {
    push16(read_hl())
    adv(1)
}

fn push_de() {
    push16(read_de())
    adv(1)
}

fn push_af() {
    push16(read_af())
    adv(1)
}

fn push_bc() {
    push16(read_bc())
    adv(1)
}

fn pop_de() {
    write_de(pop16())
    adv(1)
}

fn pop_bc() {
    write_bc(pop16())
    adv(1)
}

fn pop_af() {
    write_af(pop16())
    adv(1)
}

fn pop_hl() {
    write_hl(pop16())
    adv(1)
}

fn rrca() {
    c_flag := dev.r.a & 0x01 == 1
    dev.r.a = dev.r.a >> 1

    set_flag(.Zero, dev.r.a == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, c_flag)
    adv(1)
}

fn ret() {
    addr := pop16()
    dev.r.pc = addr
}

fn ret_z() {
    addr := pop16()
    if get_flag(.Zero) {
        dev.r.pc = addr
    } else {
        adv(1)
    }
}

fn ret_nz() {
    addr := pop16()
    if !get_flag(.Zero) {
        dev.r.pc = addr
    } else {
        adv(1)
    }
}

fn reti() {
    ret()
    dev.ime = true
}

fn call_nc_a16() {
    if get_flag(.Carry) {
        adv(3)
    } else {
        pc := u64(dev.r.pc)
        target_addr := cast(u16, dev.ram[pc+1:pc+2])

        printf("target addr %x\n", target_addr)
        push16(u16(pc) + 3) // return address = instruction after CALL
        dev.r.pc = target_addr
    }
}

fn call_a16() {
    pc := u64(dev.r.pc)
    target_addr := cast(u16, dev.ram[pc+1:pc+2])

    push16(u16(pc) + 3) // return address = instruction after CALL
    dev.r.pc = target_addr
}


fn swap_a() { swap_8(&dev.r.a) }
fn swap_b() { swap_8(&dev.r.b) }
fn swap_c() { swap_8(&dev.r.c) }
fn swap_d() { swap_8(&dev.r.d) }

fn swap_8(reg: &u8) {
    v := *reg

    nv := ((v >> 4) & 0x0F) + ((v << 4) & 0xF0)

    *reg = nv

    set_flag(.Zero, nv == 0)
    set_flag(.Subtract, false)
    set_flag(.Carry, false)
    set_flag(.HalfCarry, false)
    adv(2)
}

// -- RES n,r : reset bit n of r. Does not affect flags.
fn res_reg(bit: u8, r: &u8) {
    *r = *r & (0xFF ^ (u8(1) << bit))
    adv(2)
}

fn res_ind_hl(bit: u8) {
    addr := read_hl()
    dev.ram[addr] = dev.ram[addr] & (0xFF ^ (u8(1) << bit))
    adv(2)
}

fn res_0_b() { res_reg(0, &dev.r.b) }
fn res_0_c() { res_reg(0, &dev.r.c) }
fn res_0_d() { res_reg(0, &dev.r.d) }
fn res_0_e() { res_reg(0, &dev.r.e) }
fn res_0_h() { res_reg(0, &dev.r.h) }
fn res_0_l() { res_reg(0, &dev.r.l) }
fn res_0_hl() { res_ind_hl(0) }
fn res_0_a() { res_reg(0, &dev.r.a) }

