fn cp_a_n8() {
    pc := u64(dev.r.pc)
    im := dev.ram[pc + 1]
    val := dev.r.a

    set_flag(.Zero, im == val)
    set_flag(.Subtract, true)
    set_flag(.HalfCarry, h_flag_sub(val, im))
    set_flag(.Carry, val < im)

    adv(2)
}

fn add_r1_r2(r1: &u8, r2: &u8) {
    c_flag := *r1 + *r2 > 0xFF 
    h_flag := h_flag_add(*r1, *r2)

    *r1 = *r1 + *r2

    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    set_flag(.Carry, c_flag)

    adv(1)
}

fn add_r1_n8(r1: &u8) {
    r2 := dev.ram[dev.r.pc + 1]
    c_flag := *r1 + r2 > 0xFF 
    h_flag := h_flag_add(*r1, r2)

    *r1 = *r1 + r2

    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, h_flag)
    set_flag(.Carry, c_flag)

    adv(2)
}

fn or_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 | *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, false)

    adv(1)
}

fn or_r1_n8(r1: &u8) {
    val := dev.ram[dev.r.pc + 1]
    *r1 = *r1 | val
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false) // Halfcarry is false in case of OR
    set_flag(.Carry, false)

    adv(2)
}

fn xor_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 ^ *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, false)
    set_flag(.Carry, false)

    adv(1)
}

fn and_r1_r2(r1: &u8, r2: &u8) {
    *r1 = *r1 & *r2
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true) // Halfcarry is true in case of AND
    set_flag(.Carry, false)

    adv(1)
}

fn and_r1_n8(r1: &u8) {
    val := dev.ram[dev.r.pc + 1]
    *r1 = *r1 & val
    set_flag(.Zero, *r1 == 0)
    set_flag(.Subtract, false)
    set_flag(.HalfCarry, true) // Halfcarry is true in case of AND
    set_flag(.Carry, false)

    adv(2)
}

fn add_a_a() {
    add_r1_r2(&dev.r.a, &dev.r.a)
}

fn add_a_n8() {
    add_r1_n8(&dev.r.a)
}

fn add_a_l() {
    add_r1_r2(&dev.r.a, &dev.r.l)
}

fn add_hl_de() {
    hl := read_hl()
    de := read_de()
    sum := u32(hl) + u32(de)

    set_flag(.Subtract, false)
    set_flag(.HalfCarry, (hl & 0x0FFF) + (de & 0x0FFF) > 0x0FFF)
    set_flag(.Carry, sum > 0xFFFF)

    write_hl(u16(sum))
    adv(1)
}

fn add_hl_bc() {
    hl := read_hl()
    bc := read_bc()
    sum := u32(hl) + u32(bc)

    set_flag(.Subtract, false)
    set_flag(.HalfCarry, (hl & 0x0FFF) + (bc & 0x0FFF) > 0x0FFF)
    set_flag(.Carry, sum > 0xFFFF)

    write_hl(u16(sum))
    adv(1)
}

