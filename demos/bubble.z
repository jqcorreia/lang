import "std:c"

import "vendor:raylib"

W : i32 = 400
H : i32 = 800
background_color := Color{ r= 100, g= 100, b= 0, a= 255 }

fn main() {

    InitWindow(W, H, "Bubble")

    for {
        if IsKeyPressed(256) { // escape key
            break
        }
        BeginDrawing()
        ClearBackground(background_color)
        for y in 0..10 {
            for x in 0..10 {
                _x : i32 = x * 2
                _y : i32 = y * 2
                DrawCircle(_x * 20, _y * 20, 20, Color{ r= 100, g= 0, b= 0, a= 255 }) 
            }
        }
        EndDrawing()
    }
    CloseWindow()
}
