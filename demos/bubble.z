import "std:c"

import "vendor:raylib"

W : i32 = 800
H : i32 = 800
background_color := Color{ r= 100, g= 100, b= 0, a= 255 }

fn main() {
    InitWindow(W, H, "Bubble")

    for {
        if IsKeyPressed(256) { // escape key
            break
        }
        BeginDrawing()
        ClearBackground(background_color)
        for y in 0..10 {
            for x in 0..10 {
                cx: i32 = 0
                cy: i32 = 0
                if y % 2 == 0 {
                    cx := x * 20 * 2
                    cy = y * 20 * 2 - 20
                } else {
                    cx = x * 20 * 2 - 20
                    cy = y * 20 * 2 - 20
                }
                DrawCircle(cx, cy, 20, Color{ r= 100, g= 0, b= 0, a= 255 }) 
            }
        }
        EndDrawing()
    }
    CloseWindow()
}
