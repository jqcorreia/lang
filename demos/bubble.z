import "std:c"
import "std:math"

import "vendor:raylib"

W : i32 = 800
H : i32 = 800
background_color := Color{ r= 100, g= 100, b= 0, a= 255 }
bubble_color : [8]Color = [
    Color { r = 230, g = 30,  b = 30,  a = 255 } // red
    Color { r = 30,  g = 80,  b = 240, a = 255 } // blue
    Color { r = 40,  g = 200, b = 60,  a = 255 } // green
    Color { r = 250, g = 220, b = 30,  a = 255 } // yellow
    Color { r = 40,  g = 220, b = 230, a = 255 } // cyan
    Color { r = 230, g = 40,  b = 200, a = 255 } // magenta
    Color { r = 250, g = 130, b = 30,  a = 255 } // orange
    Color { r = 150, g = 40,  b = 220, a = 255 } // purple
]

bubble_radius: i32 = 30
SQRT3 : f32 = 1.7320508

enum BubbleType {
    None
    Normal
}

struct Bubble {
    type: BubbleType
    color_idx: u32
    moving: bool
    pos: [2]f32
    vel: [2]f32
}

struct Map {
    data: [12][12]Bubble
}

struct Cannon {
    rect : Rectangle
    angle: f32
    rotation_speed: f32
}

struct State {
    running: bool
    map: Map
    cannon: Cannon
    active: Bubble
}

state: State

fn dist(v1: [2]i32, v2: [2]i32) -> f64 {
    x := (v2[0] - v1[0]) * (v2[0] - v1[0])
    y := (v2[1] - v1[1]) * (v2[1] - v1[1])

    return sqrt(f64(x + y))
}

fn shoot(map: &Map, cannon: Cannon) {
    norm_angle := f64(cannon.angle + 90)

    state.active.moving = true
    state.active.pos = [cannon.rect.x, cannon.rect.y]
    rad_angle := to_rad(norm_angle)
    state.active.vel = [-f32(cos(rad_angle)), -f32(sin(rad_angle))]
}

fn draw(bubble: Bubble) {
    bc := bubble_color[bubble.color_idx]
    DrawCircle(i32(bubble.pos[0]), i32(bubble.pos[1]), f32(bubble_radius), bc) 
}


fn init() {
    state = State {
        active = Bubble { type = .Normal, color_idx = 1 }  
        map = Map{}
        cannon = Cannon{ 
            rect = Rectangle { x = 350, y = 800, width = 50, height = 100 } 
            angle = 0
            rotation_speed = 100
        }
        running = true
    }
}

fn update() {
    etime := f32(GetFrameTime())
    delta_angle := etime * state.cannon.rotation_speed

    if IsKeyPressed(KeyboardKey.ESCAPE) { 
        state.running = false
    }
    if IsKeyDown(KeyboardKey.LEFT) { 
        state.cannon.angle = state.cannon.angle - delta_angle
    }
    if IsKeyDown(KeyboardKey.RIGHT) { 
        state.cannon.angle = state.cannon.angle + delta_angle
    }
    if IsKeyPressed(KeyboardKey.SPACE) {
        shoot(&state.map, state.cannon)
    }

    if state.active.moving {
        // Wall collision
        if state.active.pos[0] < 0 || state.active.pos[0] > f32(W) {
            state.active.vel[0] = -state.active.vel[0]
        }
    
        // Map bubble collision
        for y in 0..10 {
            for x in 0..10 {
                b := state.map.data[y][x]
                if b.type == .Normal {
                    b_pos := grid_to_pix(x, y)
                    a_pos := [i32(state.active.pos[0]), i32(state.active.pos[1])]
                    if dist(b_pos, a_pos) < f64(bubble_radius * 2) {
                        state.active.moving = false

                        grid_hit := pix_to_grid(a_pos[0], a_pos[1])
                        printf("grid hit x: %d, y: %d\n", grid_hit[0], grid_hit[1])
                        state.map.data[grid_hit[1]][grid_hit[0]] = Bubble { type = .Normal, color_idx = 1 }
                    }
                }

            }
        }
        state.active.pos = state.active.pos + state.active.vel
    }
}

fn grid_to_pix(x: i32, y: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    cx: i32 = 0
    cy: i32 = 0

    cy = i32(f32(y) * fr * SQRT3 + fr)
    if y % 2 == 0 {
        cx = x * bubble_radius * 2 + bubble_radius
    } else {
        cx = x * bubble_radius * 2 + bubble_radius * 2
    }

    return [cx, cy]
}

fn pix_to_grid(cx: i32, cy: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    x: i32 = 0
    y: i32 = 0

    fy := (f32(cy) - fr) / (fr * SQRT3)
    y = i32(fy + 0.5)

    if y % 2 == 0 {
        fx := (f32(cx) - fr) / (fr * 2.0)
        x = i32(fx + 0.5)
    } else {
        fx := (f32(cx) - fr * 2.0) / (fr * 2.0)
        x = i32(fx + 0.5)
    }

    return [x, y]
}

fn render() {
    BeginDrawing()
    ClearBackground(background_color)
    for y in 0..10 {
        for x in 0..10 {
            bubble := state.map.data[y][x]
            pix_pos := grid_to_pix(x, y)
            if bubble.type == .Normal {
                bc := bubble_color[state.map.data[y][x].color_idx]
                DrawCircle(pix_pos[0], pix_pos[1], f32(bubble_radius), bc) 
            }
        }
    }
    if state.active.moving {
        draw(state.active)
    }
    DrawRectanglePro(state.cannon.rect, Vector2 { x = state.cannon.rect.width / 2, y = state.cannon.rect.height }, state.cannon.angle, Color { r = 255, g = 100, b = 100, a = 255 })
    EndDrawing()
}

fn main() {

    init()

    // Init map
    for y in 0..10 {
        for x in 0..10 {
            rand_color := random() % 8
            bubble := Bubble { type = .Normal, color_idx = rand_color }
            if y > 6 && x > 2 && x < 8 {
                bubble.type = .None
            } 
            state.map.data[y][x] = bubble
        }
    }

    SetConfigFlags(32) // MSAA 4X
    InitWindow(W, H, "Bubble")

    for {
        if state.running == false {
            break
        }
        update()
        render()
    }

    CloseWindow()
}
