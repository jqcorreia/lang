import "std:c"
import "std:math"

import "vendor:raylib"

W :: 800
H :: 800
GRID_W :: 20
GRID_H :: 12

background_color := Color{ r= 100, g= 100, b= 0, a= 255 }
bubble_color : [8]Color = [
    Color { r = 230, g = 30,  b = 30,  a = 255 } // red
    Color { r = 30,  g = 80,  b = 240, a = 255 } // blue
    Color { r = 40,  g = 200, b = 60,  a = 255 } // green
    Color { r = 250, g = 220, b = 30,  a = 255 } // yellow
    Color { r = 40,  g = 220, b = 230, a = 255 } // cyan
    Color { r = 230, g = 40,  b = 200, a = 255 } // magenta
    Color { r = 250, g = 130, b = 30,  a = 255 } // orange
    Color { r = 150, g = 40,  b = 220, a = 255 } // purple
]

bubble_radius: i32 = 30
SQRT3 : f32 = 1.7320508

enum BubbleType {
    None
    Normal
}

struct Bubble {
    type: BubbleType
    color_idx: u32
    moving: bool
    pos: [2]f32
    vel: [2]f32
}

struct Map {
    data: [GRID_H][GRID_W]Bubble
}

struct Cannon {
    rect : Rectangle
    angle: f32
    rotation_speed: f32
}

struct Game {
    running: bool
    map: Map
    cannon: Cannon
    active: Bubble
}

game: Game

fn dist(v1: [2]i32, v2: [2]i32) -> f64 {
    x := (v2[0] - v1[0]) * (v2[0] - v1[0])
    y := (v2[1] - v1[1]) * (v2[1] - v1[1])

    return sqrt(f64(x + y))
}

fn shoot(map: &Map, cannon: Cannon) {
    if game.active.moving {
        return
    }
    norm_angle := f64(cannon.angle + 90)

    game.active.moving = true
    game.active.pos = [cannon.rect.x, cannon.rect.y]
    rad_angle := to_rad(norm_angle)
    game.active.vel = [-f32(cos(rad_angle)), -f32(sin(rad_angle))]
}

fn draw(bubble: Bubble) {
    bc := bubble_color[bubble.color_idx]
    DrawCircle(i32(bubble.pos[0]), i32(bubble.pos[1]), f32(bubble_radius), bc) 
}



fn grid_to_pix(x: i32, y: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    cx: i32 = 0
    cy: i32 = 0

    cy = i32(f32(y) * fr * SQRT3 + fr)
    if y % 2 == 0 {
        cx = x * bubble_radius * 2 + bubble_radius
    } else {
        cx = x * bubble_radius * 2 + bubble_radius * 2
    }

    return [cx, cy]
}

fn pix_to_grid(cx: i32, cy: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    x: i32 = 0
    y: i32 = 0

    fy := (f32(cy) - fr) / (fr * SQRT3)
    y = i32(fy + 0.5)

    if y % 2 == 0 {
        fx := (f32(cx) - fr) / (fr * 2.0)
        x = i32(fx + 0.5)
    } else {
        fx := (f32(cx) - fr * 2.0) / (fr * 2.0)
        x = i32(fx + 0.5)
    }

    return [x, y]
}

fn neighbors(x: i32, y: i32) -> [6][2]i32 {
    if y % 2 == 0 {
        return [
            [x - 1, y    ],
            [x + 1, y    ],
            [x - 1, y - 1],
            [x,     y - 1],
            [x - 1, y + 1],
            [x,     y + 1]
        ]
    } 
    return [
        [x - 1, y    ],
        [x + 1, y    ],
        [x,     y - 1],
        [x + 1, y - 1],
        [x,     y + 1],
        [x + 1, y + 1]
    ]
}

fn match_check(gx: i32, gy: i32) {
    if game.map.data[gy][gx].type != .Normal {
        return
    }

    target_color := game.map.data[gy][gx].color_idx
    visited: [GRID_H][GRID_W]bool

    queue: [GRID_W * GRID_H][2]i32
    head: i32 = 0
    tail: i32 = 0

    matched: [GRID_W * GRID_H][2]i32
    matched_count: i32 = 0

    queue[tail] = [gx, gy]
    tail = tail + 1
    visited[gy][gx] = true

    for {
        if head >= tail { 
            break 
        }

        cell := queue[head]
        head = head + 1
        cx := cell[0]
        cy := cell[1]

        matched[matched_count] = [cx, cy]
        matched_count = matched_count + 1

        nbrs := neighbors(cx, cy)
        for i in 0..6 {
            nx := nbrs[i][0]
            ny := nbrs[i][1]
            if nx >= 0 && nx < GRID_W && ny >= 0 && ny < GRID_H {
                if visited[ny][nx] == false {
                    nb := game.map.data[ny][nx]
                    if nb.type == .Normal && nb.color_idx == target_color {
                        visited[ny][nx] = true
                        queue[tail] = [nx, ny]
                        tail = tail + 1
                    }
                }
            }
        }
    }

    if matched_count >= 3 {
        for i in 0..matched_count{
            mx := matched[i][0]
            my := matched[i][1]
            game.map.data[my][mx].type = .None
        }
    }
}

fn drop_floaters() {
    reachable: [GRID_H][GRID_W]bool
    queue: [GRID_W * GRID_H][2]i32
    head: i32 = 0
    tail: i32 = 0

    for x in 0..GRID_W {
        if game.map.data[0][x].type == .Normal {
            reachable[0][x] = true
            queue[tail] = [x, 0]
            tail = tail + 1
        }
    }

    for {
        if head >= tail { 
            break 
        }
        cell := queue[head]
        head = head + 1
        cx := cell[0]
        cy := cell[1]

        nbrs := neighbors(cx, cy)
        for i in 0..6 {
            nx := nbrs[i][0]
            ny := nbrs[i][1]
            if nx >= 0 && nx < GRID_W && ny >= 0 && ny < GRID_H {
                if reachable[ny][nx] == false {
                    if game.map.data[ny][nx].type == .Normal {
                        reachable[ny][nx] = true
                        queue[tail] = [nx, ny]
                        tail = tail + 1
                    }
                }
            }
        }
    }

    for y in 0..GRID_H {
        for x in 0..GRID_W {
            if game.map.data[y][x].type == .Normal {
                if reachable[y][x] == false {
                    game.map.data[y][x].type = .None
                }
            }
        }
    }
}

fn init() {
    game = Game {
        active = Bubble { type = .Normal, color_idx = 1 }  
        map = Map{}
        cannon = Cannon{ 
            rect = Rectangle { x = 350, y = 800, width = 50, height = 100 } 
            angle = 0
            rotation_speed = 100
        }
        running = true
    }
}

fn update() {
    etime := f32(GetFrameTime())
    delta_angle := etime * game.cannon.rotation_speed

    if IsKeyPressed(KeyboardKey.ESCAPE) { 
        game.running = false
    }
    if IsKeyDown(KeyboardKey.LEFT) { 
        game.cannon.angle = game.cannon.angle - delta_angle
    }
    if IsKeyDown(KeyboardKey.RIGHT) { 
        game.cannon.angle = game.cannon.angle + delta_angle
    }
    if IsKeyPressed(KeyboardKey.SPACE) {
        shoot(&game.map, game.cannon)
    }

    if game.active.moving {
        // Wall collision
        if game.active.pos[0] < 0 || game.active.pos[0] > f32(W) {
            game.active.vel[0] = -game.active.vel[0]
        }
    
        done_checking := false
        // Map bubble collision
        for y in 0..GRID_H {
            if done_checking {
                    break
            }
            for x in 0..GRID_W {
                b := &game.map.data[y][x]
                if b.type == .Normal {
                    b_pos := grid_to_pix(x, y)
                    a_pos := [i32(game.active.pos[0]), i32(game.active.pos[1])]
                    if dist(b_pos, a_pos) < f64(bubble_radius * 2) {
                        game.active.moving = false

                        grid_hit := pix_to_grid(a_pos[0], a_pos[1])
                        grid_hit[0] = clampi32(grid_hit[0], 0, GRID_W - 1)
                        grid_hit[1] = clampi32(grid_hit[1], 0, GRID_H - 1)
                        game.map.data[grid_hit[1]][grid_hit[0]] = game.active

                        match_check(grid_hit[0], grid_hit[1])
                        drop_floaters()
                        done_checking = true
                        break
                    }
                }
            }
        }
        game.active.pos = game.active.pos + game.active.vel
    }
}

fn render() {
    BeginDrawing()
    ClearBackground(background_color)
    for y in 0..GRID_H {
        for x in 0..GRID_W {
            bubble := game.map.data[y][x]
            pix_pos := grid_to_pix(x, y)
            if bubble.type == .Normal {
                bc := bubble_color[game.map.data[y][x].color_idx]
                DrawCircle(pix_pos[0], pix_pos[1], f32(bubble_radius), bc) 
                DrawCircleLines(pix_pos[0], pix_pos[1], f32(bubble_radius), Color {r = 0, g = 0, b = 0, a = 255}) 
            }
        }
    }
    if game.active.moving {
        draw(game.active)
    }
    DrawRectanglePro(game.cannon.rect, Vector2 { x = game.cannon.rect.width / 2, y = game.cannon.rect.height }, game.cannon.angle, Color { r = 255, g = 100, b = 100, a = 255 })
    EndDrawing()
}

fn main() {

    init()

    // Init map
    for y in 0..10 {
        for x in 0..10 {
            rand_color := random() % 8
            bubble := Bubble { type = .Normal, color_idx = rand_color }
            if y > 6 && x > 2 && x < 8 {
                bubble.type = .None
            } 
            game.map.data[y][x] = bubble
        }
    }

    SetConfigFlags(32) // MSAA 4X
    InitWindow(W, H, "Bubble")
    for {
        if game.running == false {
            break
        }
        update()
        render()
    }

    CloseWindow()
}
