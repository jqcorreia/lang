import "std:c"

import "vendor:raylib"

W : i32 = 800
H : i32 = 800

background_color := Color{ r= 100, g= 100, b= 0, a= 255 }

bubble_color : [8]Color = [
    Color { r = 230, g = 30,  b = 30,  a = 255 } // red
    Color { r = 30,  g = 80,  b = 240, a = 255 } // blue
    Color { r = 40,  g = 200, b = 60,  a = 255 } // green
    Color { r = 250, g = 220, b = 30,  a = 255 } // yellow
    Color { r = 40,  g = 220, b = 230, a = 255 } // cyan
    Color { r = 230, g = 40,  b = 200, a = 255 } // magenta
    Color { r = 250, g = 130, b = 30,  a = 255 } // orange
    Color { r = 150, g = 40,  b = 220, a = 255 } // purple
]

bubble_radius: i32 = 30
bubble_radius_f: f32 = 30

enum BubbleType {
    None
    Normal
}

struct Bubble {
    type: BubbleType
    color_idx: u32
}

struct Map {
    data: [12][12]Bubble
}

struct Cannon {
    rect : Rectangle
    angle: f32
}

fn main() {
    map := Map{}
    cannon := Cannon{ 
    rect = Rectangle { x = 350, y = 800, width = 50, height = 100 } 
        angle = 0
    }

    for y in 0..10 {
        for x in 0..10 {
            rand_color := random() % 8
            bubble := Bubble { type = BubbleType.Normal, color_idx = rand_color }
            if y > 6 && x > 2 && x < 8 {
                bubble.type = BubbleType.None
            } 
            map.data[y][x] = bubble
        }
    }

    SetConfigFlags(32) // MSAA 4X
    InitWindow(W, H, "Bubble")

    for {
        if IsKeyPressed(KeyboardKey.ESCAPE) { // escape key
            break
        }
        if IsKeyDown(KeyboardKey.LEFT) { 
            cannon.angle = cannon.angle - 0.2
        }
        if IsKeyDown(KeyboardKey.RIGHT) { 
            cannon.angle = cannon.angle + 0.2
        }

        BeginDrawing()
        ClearBackground(background_color)
        for y in 0..10 {
            for x in 0..10 {
                bubble := map.data[y][x]
                cx: i32 = 0
                cy: i32 = 0
                if y % 2 == 0 {
                    cx = x * bubble_radius * 2
                    cy = y * bubble_radius * 2 - bubble_radius
                } else {
                    cx = x * bubble_radius * 2 - bubble_radius
                    cy = y * bubble_radius * 2 - bubble_radius
                }
                if bubble.type == BubbleType.Normal {
                    bc := bubble_color[map.data[y][x].color_idx]
                    DrawCircle(cx, cy, bubble_radius_f, bc) 
                }
            }
        }
        DrawRectanglePro(cannon.rect, Vector2 { x = cannon.rect.width / 2, y = cannon.rect.height }, cannon.angle, Color { r = 255, g = 100, b = 100, a = 255 })
        EndDrawing()
    }

    CloseWindow()
}
