import "std:c"

import "vendor:raylib"

W : i32 = 800
H : i32 = 800

background_color := Color{ r= 100, g= 100, b= 0, a= 255 }

bubble_color : [8]Color = [
    Color { r = 230, g = 30,  b = 30,  a = 255 } // red
    Color { r = 30,  g = 80,  b = 240, a = 255 } // blue
    Color { r = 40,  g = 200, b = 60,  a = 255 } // green
    Color { r = 250, g = 220, b = 30,  a = 255 } // yellow
    Color { r = 40,  g = 220, b = 230, a = 255 } // cyan
    Color { r = 230, g = 40,  b = 200, a = 255 } // magenta
    Color { r = 250, g = 130, b = 30,  a = 255 } // orange
    Color { r = 150, g = 40,  b = 220, a = 255 } // purple
]

struct Map {
    data: [10][10]i64
}

fn main() {
    map := Map{}
    for y in 0..10 {
        for x in 0..10 {
            rand_color := random() % 8
            map.data[y][x] = rand_color
        }
    }
    

    SetConfigFlags(32) // MSAA 4X
    InitWindow(W, H, "Bubble")

    for {
        if IsKeyPressed(256) { // escape key
            break
        }
        BeginDrawing()
        ClearBackground(background_color)
        for y in 0..10 {
            for x in 0..10 {
                rand_color := random() % 8
                cx: i32 = 0
                cy: i32 = 0
                if y % 2 == 0 {
                    cx = x * 20 * 2
                    cy = y * 20 * 2 - 20
                } else {
                    cx = x * 20 * 2 - 20
                    cy = y * 20 * 2 - 20
                }
                DrawCircle(cx, cy, 20, bubble_color[map.data[y][x]]) 
            }
        }
        EndDrawing()
    }
    CloseWindow()
}
