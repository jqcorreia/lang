import "std:c"
import "std:math"

import "vendor:raylib"
import "utils"

W :: 800
H :: 800
GRID_W :: 12
GRID_H :: 12
SHOOT_SPEED :: 100

background_color := Color{ r= 100, g= 100, b= 0, a= 255 }
bubble_color : [8]Color = [
    Color { r = 230, g = 30,  b = 30,  a = 255 } // red
    Color { r = 30,  g = 80,  b = 240, a = 255 } // blue
    Color { r = 40,  g = 200, b = 60,  a = 255 } // green
    Color { r = 250, g = 220, b = 30,  a = 255 } // yellow
    Color { r = 40,  g = 220, b = 230, a = 255 } // cyan
    Color { r = 230, g = 40,  b = 200, a = 255 } // magenta
    Color { r = 250, g = 130, b = 30,  a = 255 } // orange
    Color { r = 150, g = 40,  b = 220, a = 255 } // purple
]

bubble_radius: i32 = 32
SQRT3 : f32 = 1.7320508

enum BubbleType {
    None
    Normal
}

tex: Texture

struct Bubble {
    type: BubbleType
    color_idx: u32
    moving: bool
    pos: [2]f32
    vel: [2]f32
    acc: [2]f32
}

struct Map {
    data: [GRID_H][GRID_W]Bubble
}

struct Cannon {
    rect : Rectangle
    angle: f32
    rotation_speed: f32
}

struct Game {
    running: bool
    map: Map
    cannon: Cannon
    active: Bubble
    next_color_idx: u32
}

game: Game

fn dist(v1: [2]i32, v2: [2]i32) -> f64 {
    x := (v2[0] - v1[0]) * (v2[0] - v1[0])
    y := (v2[1] - v1[1]) * (v2[1] - v1[1])

    return sqrt(f64(x + y))
}


fn grid_to_pix(x: i32, y: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    cx: i32 = 0
    cy: i32 = 0

    cy = i32(f32(y) * fr * SQRT3 + fr)
    if y % 2 == 0 {
        cx = x * bubble_radius * 2 + bubble_radius
    } else {
        cx = x * bubble_radius * 2 + bubble_radius * 2
    }

    return [cx, cy]
}

fn pix_to_grid(cx: i32, cy: i32) -> [2]i32 {
    fr := f32(bubble_radius)
    x: i32 = 0
    y: i32 = 0

    fy := (f32(cy) - fr) / (fr * SQRT3)
    y = i32(fy + 0.5)

    if y % 2 == 0 {
        fx := (f32(cx) - fr) / (fr * 2.0)
        x = i32(fx + 0.5)
    } else {
        fx := (f32(cx) - fr * 2.0) / (fr * 2.0)
        x = i32(fx + 0.5)
    }

    return [x, y]
}


fn shoot(map: &Map, cannon: Cannon) {
    if game.active.moving {
        return
    }
    norm_angle := f64(cannon.angle + 90)

    game.active.color_idx = game.next_color_idx
    game.active.moving = true
    game.active.pos = [cannon.rect.x, cannon.rect.y]
    rad_angle := to_rad(norm_angle)
    game.active.vel = [-f32(cos(rad_angle)) * 1600, -f32(sin(rad_angle)) * 1600]

    game.next_color_idx = u32(random() % 8)
}


fn init() {
    // image := LoadImage("spheres.png")
    tex = LoadTexture("demos/sphere.png")

    game = Game {
        active = Bubble { type = .Normal, color_idx = 1 }  
        map = Map{}
        cannon = Cannon{ 
            rect = Rectangle { x = 350, y = 800, width = 50, height = 100 } 
            angle = 0
            rotation_speed = 100
        }
        running = true
        next_color_idx = u32(random() % 8)
    }
}

fn update() {
    etime := f32(GetFrameTime())
    delta_angle := etime * game.cannon.rotation_speed

    if IsKeyPressed(KeyboardKey.ESCAPE) { 
        game.running = false
    }
    if IsKeyPressed(KeyboardKey.Q) { 
        drop_all()
    }
    if IsKeyDown(KeyboardKey.LEFT) { 
        game.cannon.angle = game.cannon.angle - delta_angle
    }
    if IsKeyDown(KeyboardKey.RIGHT) { 
        game.cannon.angle = game.cannon.angle + delta_angle
    }
    if IsKeyPressed(KeyboardKey.SPACE) {
        shoot(&game.map, game.cannon)
    }
    game.cannon.angle = clampf32(game.cannon.angle, -70, 70)

    for y in 0..GRID_H {
        for x in 0..GRID_W {
            b := &game.map.data[y][x]
            b.pos[0] = b.pos[0] + b.vel[0] * etime
            b.pos[1] = b.pos[1] + b.vel[1] * etime

            if b.pos[1] > f32(H) {
                b.type = .None
            }
        }
    }
    if game.active.moving {
        // Wall collision
        if game.active.pos[0] < 0 || game.active.pos[0] > f32(W) {
            game.active.vel[0] = -game.active.vel[0]
        }
    
        done_checking := false
        // Map bubble collision
        for y in 0..GRID_H {
            if done_checking {
                    break
            }
            for x in 0..GRID_W {
                b := &game.map.data[y][x]
                if b.type == .Normal {
                    b_pos := grid_to_pix(x, y)
                    a_pos := [i32(game.active.pos[0]), i32(game.active.pos[1])]
                    if dist(b_pos, a_pos) < f64(bubble_radius * 2) {
                        game.active.moving = false

                        grid_hit := pix_to_grid(a_pos[0], a_pos[1])
                        grid_hit[0] = clampi32(grid_hit[0], 0, GRID_W - 1)
                        grid_hit[1] = clampi32(grid_hit[1], 0, GRID_H - 1)
                        gp := grid_to_pix(grid_hit[0], grid_hit[1])
                        game.active.pos = [f32(gp[0]), f32(gp[1])]
                        game.active.vel = [f32(0), f32(0)]
                        game.map.data[grid_hit[1]][grid_hit[0]] = game.active

                        match_check(grid_hit[0], grid_hit[1])
                        drop_floaters()
                        done_checking = true
                        break
                    }
                }
            }
        }
        // Update active bubble pos
        game.active.pos[0] = game.active.pos[0] + game.active.vel[0] * etime
        game.active.pos[1] = game.active.pos[1] + game.active.vel[1] * etime
    }
}

fn draw_bubble(bubble: Bubble) {
    draw_bubble_pos(i32(bubble.pos[0]), i32(bubble.pos[1]), bubble)
}

fn draw_bubble_pos(x: i32, y: i32, bubble: Bubble) {
    radius :f32= 32
    bc := bubble_color[bubble.color_idx]

    src := Rectangle { x = 0, y = 0, width = radius * 2, height = radius * 2}
    dst := Rectangle { x = f32(x) - radius, y = f32(y) - radius, width = radius * 2, height = radius * 2 }
    origin := Vector2 { x = 0, y = 0 }
    rotation: f32 = 0
    DrawTexturePro(tex, src, dst, origin, rotation, bc)
}


fn render() {
    BeginDrawing()
    ClearBackground(background_color)
    for y in 0..GRID_H {
        for x in 0..GRID_W {
            bubble := game.map.data[y][x]
            if bubble.type == .Normal {
                draw_bubble(bubble)
            }
        }
    }
    if game.active.moving {
        draw_bubble(game.active)
    }
    DrawRectanglePro(game.cannon.rect, Vector2 { x = game.cannon.rect.width / 2, y = game.cannon.rect.height }, game.cannon.angle, Color { r = 255, g = 100, b = 100, a = 255 })
    // Draw preview bubble
    draw_bubble_pos(i32(game.cannon.rect.x ), W - 32, Bubble { color_idx = game.next_color_idx})
    // DrawCircle(50,700, f32(bubble_radius), bubble_color[game.next_color_idx]) 

    EndDrawing()
}

fn main() {
    SetConfigFlags(ConfigFlags.MSAA_4X_HINT)
    SetTargetFPS(60)

    DrawFPS(W-50, H - 20)
    InitWindow(W, H, "Bubble")

    init()

    // Init map
    for y in 0..GRID_H {
        for x in 0..GRID_W {
            rand_color := random() % 8
            gp := grid_to_pix(x, y)
            bubble := Bubble {
                type = .Normal,
                color_idx = u32(rand_color),
                pos = [f32(gp[0]), f32(gp[1])]
            }
            if y > 6 && x > 2 && x < 8 {
                bubble.type = .None
            }
            game.map.data[y][x] = bubble
        }
    }

    for {
        if game.running == false {
            break
        }
        update()
        render()
    }

    CloseWindow()
}
