external "m" {
    fn sin(angle: f64) -> f64
    fn cos(angle: f64) -> f64
    fn tan(angle: f64) -> f64
    fn sqrt(v: f64) -> f64
}


PI: f64 = 3.14159265359

fn to_rad(degrees: f64) -> f64 {
    return degrees * (PI / 180)
}

fn to_deg(rad: f64) -> f64 {
    return rad * (180 / PI)
}

fn clampi32(val: i32, min: i32, max: i32) -> i32 {
    if val >= max {
        return max
    }
    if val <= min {
        return min
    }
    return val
}

fn clampi64(val: i64, min: i64, max: i64) -> i64 {
    if val >= max {
        return max
    }
    if val <= min {
        return min
    }
    return val
}

fn clampf32(val: f32, min: f32, max: f32) -> f32 {
    if val >= max {
        return max
    }
    if val <= min {
        return min
    }
    return val
}

fn clampf64(val: f64, min: f64, max: f64) -> f64 {
    if val >= max {
        return max
    }
    if val <= min {
        return min
    }
    return val
}

