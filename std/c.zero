external "c" {
    fn sprintf(dest: cstr, format: cstr, args: ...anytype) -> i32
    fn printf(format: cstr, args: ...anytype) -> i32
    fn fopen(filename: cstr, mode: cstr) -> &FILE
    fn fread(ptr: rawptr, n: size_t, size: size_t, file: &FILE) -> size_t
    fn fwrite(ptr: rawptr, size: size_t, n: size_t, file: &FILE) -> size_t
    fn fputc(char: i32, file: &FILE) -> i32
    fn fputs(string: cstr, file: &FILE) -> u64
    fn fclose(file: &FILE) -> u64
    fn fflush(file: &FILE)

    fn random() -> i64

    fn sleep(secs: u64)
    fn nanosleep(spec: &timespec, rem: &timespec)
}

size_t :: i64
struct FILE {}

struct timespec {
    tv_sec: u32
    tv_nsec: u32
}
