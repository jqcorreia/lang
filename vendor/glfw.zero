}

enum WaylandLibdecor {
    PREFER_LIBDECOR = 0x00038001
    DISABLE_LIBDECOR = 0x00038002
}

enum WindowPosition {
    ANY_POSITION = 0x80000000
}

// NOTE: GLFW_*_CURSOR values intentionally collide numerically with the
// ContextCreationAPI values above (both ranges start at 0x00036001). They are
// used in different APIs so the overlap is benign.
enum CursorShape {
    ARROW = 0x00036001
    IBEAM = 0x00036002
    CROSSHAIR = 0x00036003
    POINTING_HAND = 0x00036004
    RESIZE_EW = 0x00036005
    RESIZE_NS = 0x00036006
    RESIZE_NWSE = 0x00036007
    RESIZE_NESW = 0x00036008
    RESIZE_ALL = 0x00036009
    NOT_ALLOWED = 0x0003600A
    HRESIZE = 0x00036005     // = RESIZE_EW
    VRESIZE = 0x00036006     // = RESIZE_NS
    HAND = 0x00036004        // = POINTING_HAND
}

enum ConnectionEvent {
    CONNECTED = 0x00040001
    DISCONNECTED = 0x00040002
}

enum InitHint {
    JOYSTICK_HAT_BUTTONS = 0x00050001
    ANGLE_PLATFORM_TYPE = 0x00050002
    PLATFORM = 0x00050003
    COCOA_CHDIR_RESOURCES = 0x00051001
    COCOA_MENUBAR = 0x00051002
    X11_XCB_VULKAN_SURFACE = 0x00052001
    WAYLAND_LIBDECOR = 0x00053001
}

enum Platform {
    ANY = 0x00060000
    WIN32 = 0x00060001
    COCOA = 0x00060002
    WAYLAND = 0x00060003
    X11 = 0x00060004
    NULL = 0x00060005
}

enum Misc {
    DONT_CARE = -1
}

// === EXTERNAL FUNCTIONS ===

external "glfw" {
    // === INIT / TERMINATE / VERSION ===
    fn glfwInit() -> i32
    fn glfwTerminate()
    fn glfwInitHint(hint: i32, value: i32)
    fn glfwInitAllocator(allocator: &GLFWallocator)
    // fn glfwInitVulkanLoader(loader: PFN_vkGetInstanceProcAddr)  // Vulkan type, not supported
    fn glfwGetVersion(major: &i32, minor: &i32, rev: &i32)
    fn glfwGetVersionString() -> cstr
    fn glfwGetError(description: &cstr) -> i32
    // fn glfwSetErrorCallback(callback: GLFWerrorfun) -> GLFWerrorfun  // function pointer, not supported
    fn glfwGetPlatform() -> i32
    fn glfwPlatformSupported(platform: i32) -> i32

    // === MONITOR ===
    // fn glfwGetMonitors(count: &i32) -> &&GLFWmonitor  // GLFWmonitor** (pointer-to-pointer), not supported
    fn glfwGetPrimaryMonitor() -> &GLFWmonitor
    fn glfwGetMonitorPos(monitor: &GLFWmonitor, xpos: &i32, ypos: &i32)
    fn glfwGetMonitorWorkarea(monitor: &GLFWmonitor, xpos: &i32, ypos: &i32, width: &i32, height: &i32)
    fn glfwGetMonitorPhysicalSize(monitor: &GLFWmonitor, widthMM: &i32, heightMM: &i32)
    fn glfwGetMonitorContentScale(monitor: &GLFWmonitor, xscale: &f32, yscale: &f32)
    fn glfwGetMonitorName(monitor: &GLFWmonitor) -> cstr
    fn glfwSetMonitorUserPointer(monitor: &GLFWmonitor, pointer: str)
    fn glfwGetMonitorUserPointer(monitor: &GLFWmonitor) -> str
    // fn glfwSetMonitorCallback(callback: GLFWmonitorfun) -> GLFWmonitorfun  // function pointer, not supported

    // === VIDEO MODES / GAMMA ===
    fn glfwGetVideoModes(monitor: &GLFWmonitor, count: &i32) -> &GLFWvidmode
    fn glfwGetVideoMode(monitor: &GLFWmonitor) -> &GLFWvidmode
    fn glfwSetGamma(monitor: &GLFWmonitor, gamma: f32)
    fn glfwGetGammaRamp(monitor: &GLFWmonitor) -> &GLFWgammaramp
    fn glfwSetGammaRamp(monitor: &GLFWmonitor, ramp: &GLFWgammaramp)

    // === WINDOW HINTS / CREATION ===
    fn glfwDefaultWindowHints()
    fn glfwWindowHint(hint: i32, value: i32)
    fn glfwWindowHintString(hint: i32, value: cstr)
    fn glfwCreateWindow(width: i32, height: i32, title: cstr, monitor: &GLFWmonitor, share: &GLFWwindow) -> &GLFWwindow
    fn glfwDestroyWindow(window: &GLFWwindow)
    fn glfwWindowShouldClose(window: &GLFWwindow) -> i32
    fn glfwSetWindowShouldClose(window: &GLFWwindow, value: i32)
    fn glfwGetWindowTitle(window: &GLFWwindow) -> cstr
    fn glfwSetWindowTitle(window: &GLFWwindow, title: cstr)
    fn glfwSetWindowIcon(window: &GLFWwindow, count: i32, images: &GLFWimage)
    fn glfwGetWindowPos(window: &GLFWwindow, xpos: &i32, ypos: &i32)
    fn glfwSetWindowPos(window: &GLFWwindow, xpos: i32, ypos: i32)
    fn glfwGetWindowSize(window: &GLFWwindow, width: &i32, height: &i32)
    fn glfwSetWindowSizeLimits(window: &GLFWwindow, minwidth: i32, minheight: i32, maxwidth: i32, maxheight: i32)
    fn glfwSetWindowAspectRatio(window: &GLFWwindow, numer: i32, denom: i32)
    fn glfwSetWindowSize(window: &GLFWwindow, width: i32, height: i32)
    fn glfwGetFramebufferSize(window: &GLFWwindow, width: &i32, height: &i32)
    fn glfwGetWindowFrameSize(window: &GLFWwindow, left: &i32, top: &i32, right: &i32, bottom: &i32)
    fn glfwGetWindowContentScale(window: &GLFWwindow, xscale: &f32, yscale: &f32)
    fn glfwGetWindowOpacity(window: &GLFWwindow) -> f32
    fn glfwSetWindowOpacity(window: &GLFWwindow, opacity: f32)
    fn glfwIconifyWindow(window: &GLFWwindow)
    fn glfwRestoreWindow(window: &GLFWwindow)
    fn glfwMaximizeWindow(window: &GLFWwindow)
    fn glfwShowWindow(window: &GLFWwindow)
    fn glfwHideWindow(window: &GLFWwindow)
    fn glfwFocusWindow(window: &GLFWwindow)
    fn glfwRequestWindowAttention(window: &GLFWwindow)
    fn glfwGetWindowMonitor(window: &GLFWwindow) -> &GLFWmonitor
    fn glfwSetWindowMonitor(window: &GLFWwindow, monitor: &GLFWmonitor, xpos: i32, ypos: i32, width: i32, height: i32, refreshRate: i32)
    fn glfwGetWindowAttrib(window: &GLFWwindow, attrib: i32) -> i32
    fn glfwSetWindowAttrib(window: &GLFWwindow, attrib: i32, value: i32)
    fn glfwSetWindowUserPointer(window: &GLFWwindow, pointer: str)
    fn glfwGetWindowUserPointer(window: &GLFWwindow) -> str

    // === WINDOW CALLBACKS (function pointers, not supported) ===
    // fn glfwSetWindowPosCallback(window: &GLFWwindow, callback: GLFWwindowposfun) -> GLFWwindowposfun                       // function pointer, not supported
    // fn glfwSetWindowSizeCallback(window: &GLFWwindow, callback: GLFWwindowsizefun) -> GLFWwindowsizefun                    // function pointer, not supported
    // fn glfwSetWindowCloseCallback(window: &GLFWwindow, callback: GLFWwindowclosefun) -> GLFWwindowclosefun                 // function pointer, not supported
    // fn glfwSetWindowRefreshCallback(window: &GLFWwindow, callback: GLFWwindowrefreshfun) -> GLFWwindowrefreshfun           // function pointer, not supported
    // fn glfwSetWindowFocusCallback(window: &GLFWwindow, callback: GLFWwindowfocusfun) -> GLFWwindowfocusfun                 // function pointer, not supported
    // fn glfwSetWindowIconifyCallback(window: &GLFWwindow, callback: GLFWwindowiconifyfun) -> GLFWwindowiconifyfun           // function pointer, not supported
    // fn glfwSetWindowMaximizeCallback(window: &GLFWwindow, callback: GLFWwindowmaximizefun) -> GLFWwindowmaximizefun        // function pointer, not supported
    // fn glfwSetFramebufferSizeCallback(window: &GLFWwindow, callback: GLFWframebuffersizefun) -> GLFWframebuffersizefun     // function pointer, not supported
    // fn glfwSetWindowContentScaleCallback(window: &GLFWwindow, callback: GLFWwindowcontentscalefun) -> GLFWwindowcontentscalefun  // function pointer, not supported

    // === EVENTS ===
    fn glfwPollEvents()
    fn glfwWaitEvents()
    fn glfwWaitEventsTimeout(timeout: f64)
    fn glfwPostEmptyEvent()

    // === INPUT MODES / KEY / MOUSE ===
    fn glfwGetInputMode(window: &GLFWwindow, mode: i32) -> i32
    fn glfwSetInputMode(window: &GLFWwindow, mode: i32, value: i32)
    fn glfwRawMouseMotionSupported() -> i32
    fn glfwGetKeyName(key: i32, scancode: i32) -> cstr
    fn glfwGetKeyScancode(key: i32) -> i32
    fn glfwGetKey(window: &GLFWwindow, key: i32) -> i32
    fn glfwGetMouseButton(window: &GLFWwindow, button: i32) -> i32
    fn glfwGetCursorPos(window: &GLFWwindow, xpos: &f64, ypos: &f64)
    fn glfwSetCursorPos(window: &GLFWwindow, xpos: f64, ypos: f64)

    // === CURSORS ===
    fn glfwCreateCursor(image: &GLFWimage, xhot: i32, yhot: i32) -> &GLFWcursor
    fn glfwCreateStandardCursor(shape: i32) -> &GLFWcursor
    fn glfwDestroyCursor(cursor: &GLFWcursor)
    fn glfwSetCursor(window: &GLFWwindow, cursor: &GLFWcursor)

    // === INPUT CALLBACKS (function pointers, not supported) ===
    // fn glfwSetKeyCallback(window: &GLFWwindow, callback: GLFWkeyfun) -> GLFWkeyfun                               // function pointer, not supported
    // fn glfwSetCharCallback(window: &GLFWwindow, callback: GLFWcharfun) -> GLFWcharfun                            // function pointer, not supported
    // fn glfwSetCharModsCallback(window: &GLFWwindow, callback: GLFWcharmodsfun) -> GLFWcharmodsfun                // function pointer, not supported
    // fn glfwSetMouseButtonCallback(window: &GLFWwindow, callback: GLFWmousebuttonfun) -> GLFWmousebuttonfun       // function pointer, not supported
    // fn glfwSetCursorPosCallback(window: &GLFWwindow, callback: GLFWcursorposfun) -> GLFWcursorposfun             // function pointer, not supported
    // fn glfwSetCursorEnterCallback(window: &GLFWwindow, callback: GLFWcursorenterfun) -> GLFWcursorenterfun       // function pointer, not supported
    // fn glfwSetScrollCallback(window: &GLFWwindow, callback: GLFWscrollfun) -> GLFWscrollfun                      // function pointer, not supported
    // fn glfwSetDropCallback(window: &GLFWwindow, callback: GLFWdropfun) -> GLFWdropfun                            // function pointer (and char**), not supported

    // === JOYSTICK / GAMEPAD ===
    fn glfwJoystickPresent(jid: i32) -> i32
    fn glfwGetJoystickAxes(jid: i32, count: &i32) -> &f32
    fn glfwGetJoystickButtons(jid: i32, count: &i32) -> &u8
    fn glfwGetJoystickHats(jid: i32, count: &i32) -> &u8
    fn glfwGetJoystickName(jid: i32) -> cstr
    fn glfwGetJoystickGUID(jid: i32) -> cstr
    fn glfwSetJoystickUserPointer(jid: i32, pointer: str)
    fn glfwGetJoystickUserPointer(jid: i32) -> str
    fn glfwJoystickIsGamepad(jid: i32) -> i32
    // fn glfwSetJoystickCallback(callback: GLFWjoystickfun) -> GLFWjoystickfun  // function pointer, not supported
    fn glfwUpdateGamepadMappings(string: cstr) -> i32
    fn glfwGetGamepadName(jid: i32) -> cstr
    fn glfwGetGamepadState(jid: i32, state: &GLFWgamepadstate) -> i32

    // === CLIPBOARD ===
    fn glfwSetClipboardString(window: &GLFWwindow, string: cstr)
    fn glfwGetClipboardString(window: &GLFWwindow) -> cstr

    // === TIME ===
    fn glfwGetTime() -> f64
    fn glfwSetTime(time: f64)
    fn glfwGetTimerValue() -> u64
    fn glfwGetTimerFrequency() -> u64

    // === CONTEXT ===
    fn glfwMakeContextCurrent(window: &GLFWwindow)
    fn glfwGetCurrentContext() -> &GLFWwindow
    fn glfwSwapBuffers(window: &GLFWwindow)
    fn glfwSwapInterval(interval: i32)
    fn glfwExtensionSupported(extension: cstr) -> i32
    // fn glfwGetProcAddress(procname: cstr) -> GLFWglproc  // function pointer return, not supported

    // === VULKAN ===
    fn glfwVulkanSupported() -> i32
    // fn glfwGetRequiredInstanceExtensions(count: &u32) -> &cstr                                                  // const char** (pointer-to-pointer), not supported
    // fn glfwGetInstanceProcAddress(instance: VkInstance, procname: cstr) -> GLFWvkproc                           // Vulkan type + function pointer, not supported
    // fn glfwGetPhysicalDevicePresentationSupport(instance: VkInstance, device: VkPhysicalDevice, queuefamily: u32) -> i32  // Vulkan types, not supported
    // fn glfwCreateWindowSurface(instance: VkInstance, window: &GLFWwindow, allocator: &VkAllocationCallbacks, surface: &VkSurfaceKHR) -> VkResult  // Vulkan types, not supported
}
