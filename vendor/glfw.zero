// GLFW 3.5 bindings for zerolang
// Generated from glfw3.h
//
// Type mapping:
//   int                 -> i32
//   unsigned int        -> u32
//   float               -> f32
//   double              -> f64
//   bool                -> bool  (GLFW does not really use bool — uses int)
//   char* / const char* -> cstr
//   void*               -> str   (opaque pointer)
//   unsigned char       -> u8
//   unsigned short      -> u16
//   long                -> i64
//   uint64_t            -> u64
//   T*                  -> &T
//   T arr[N]            -> [N]T
//   size_t              -> u64
//
// Opaque handle structs (GLFWmonitor, GLFWwindow, GLFWcursor) are defined as
// empty structs; the C `T*` becomes `&T`.
//
// Not supported (commented out):
//   typedef function pointers     (no fn-pointer type)
//   any function taking or returning a function pointer
//     (every glfwSet*Callback, plus glfwGetProcAddress / glfwGetInstanceProcAddress)
//   char** / const char**         (pointer-to-pointer) — affects glfwGetMonitors,
//                                  glfwGetRequiredInstanceExtensions, GLFWdropfun
//   Vulkan-typed APIs             (VkInstance / VkResult / VkSurfaceKHR / etc.)
//   GLFWallocator fields          (function-pointer members) — represented as
//                                  opaque `str` so the struct itself remains usable.
//   #define aliases that point at another #define (LEFT/RIGHT/etc.) are kept as
//   comments with their resolved numeric value where useful.

// === OPAQUE HANDLE STRUCTS ===

struct GLFWmonitor {}
struct GLFWwindow {}
struct GLFWcursor {}

// === CONCRETE STRUCTS ===

struct GLFWvidmode {
    width: i32
    height: i32
    redBits: i32
    greenBits: i32
    blueBits: i32
    refreshRate: i32
}

struct GLFWgammaramp {
    red: &u16
    green: &u16
    blue: &u16
    size: u32
}

struct GLFWimage {
    width: i32
    height: i32
    pixels: &u8
}

struct GLFWgamepadstate {
    buttons: [15]u8
    axes: [6]f32
}

struct GLFWallocator {
    // allocate / reallocate / deallocate are function pointers — represented
    // as opaque pointers so the struct still has the correct layout/size.
    allocate: str
    reallocate: str
    deallocate: str
    user: str
}

// === TYPEDEFS / FUNCTION POINTERS (not supported) ===
// typedef GLFWglproc                = void (*)()
// typedef GLFWvkproc                = void (*)()
// typedef GLFWallocatefun           = void* (*)(size_t, void*)
// typedef GLFWreallocatefun         = void* (*)(void*, size_t, void*)
// typedef GLFWdeallocatefun         = void (*)(void*, void*)
// typedef GLFWerrorfun              = void (*)(int, const char*)
// typedef GLFWwindowposfun          = void (*)(GLFWwindow*, int, int)
// typedef GLFWwindowsizefun         = void (*)(GLFWwindow*, int, int)
// typedef GLFWwindowclosefun        = void (*)(GLFWwindow*)
// typedef GLFWwindowrefreshfun      = void (*)(GLFWwindow*)
// typedef GLFWwindowfocusfun        = void (*)(GLFWwindow*, int)
// typedef GLFWwindowiconifyfun      = void (*)(GLFWwindow*, int)
// typedef GLFWwindowmaximizefun     = void (*)(GLFWwindow*, int)
// typedef GLFWframebuffersizefun    = void (*)(GLFWwindow*, int, int)
// typedef GLFWwindowcontentscalefun = void (*)(GLFWwindow*, float, float)
// typedef GLFWmousebuttonfun        = void (*)(GLFWwindow*, int, int, int)
// typedef GLFWcursorposfun          = void (*)(GLFWwindow*, double, double)
// typedef GLFWcursorenterfun        = void (*)(GLFWwindow*, int)
// typedef GLFWscrollfun             = void (*)(GLFWwindow*, double, double)
// typedef GLFWkeyfun                = void (*)(GLFWwindow*, int, int, int, int)
// typedef GLFWcharfun               = void (*)(GLFWwindow*, unsigned int)
// typedef GLFWcharmodsfun           = void (*)(GLFWwindow*, unsigned int, int)
// typedef GLFWdropfun               = void (*)(GLFWwindow*, int, const char*[])
// typedef GLFWmonitorfun            = void (*)(GLFWmonitor*, int)
// typedef GLFWjoystickfun           = void (*)(int, int)

// === ENUMS ===

enum VersionInfo {
    VERSION_MAJOR = 3
    VERSION_MINOR = 5
