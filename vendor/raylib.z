// raylib v6.0 bindings for zerolang
// Generated from raylib.h
//
// Type mapping:
//   int             -> i32
//   unsigned int    -> u32
//   float           -> f32
//   double          -> f64
//   bool            -> bool
//   char* / const char* -> cstr
//   void*           -> str  (opaque pointer)
//   unsigned char   -> u8
//   unsigned short  -> u16
//   long            -> i64
//   T*              -> &T
//   T arr[N]        -> [N]T
//
// Not supported (commented out):
//   typedef enum    (no enum support yet)
//   #define         (no define support)
//   function pointers
//   char**          (pointer-to-pointer)
//   Typedef aliases (Texture2D=Texture, Camera=Camera3D, etc.)

// === STRUCTS ===

struct Vector2 {
    x: f32
    y: f32
}

struct Vector3 {
    x: f32
    y: f32
    z: f32
}

struct Vector4 {
    x: f32
    y: f32
    z: f32
    w: f32
}

// Quaternion = Vector4

struct Matrix {
    m0: f32
    m4: f32
    m8: f32
    m12: f32
    m1: f32
    m5: f32
    m9: f32
    m13: f32
    m2: f32
    m6: f32
    m10: f32
    m14: f32
    m3: f32
    m7: f32
    m11: f32
    m15: f32
}

struct Color {
    r: u8
    g: u8
    b: u8
    a: u8
}

struct Rectangle {
    x: f32
    y: f32
    width: f32
    height: f32
}

struct Image {
    data: cstr
    width: i32
    height: i32
    mipmaps: i32
    format: i32
}

struct Texture {
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    format: i32
}

// Texture2D = Texture
// TextureCubemap = Texture

struct RenderTexture {
    id: u32
    texture: Texture
    depth: Texture
}

// RenderTexture2D = RenderTexture

struct NPatchInfo {
    source: Rectangle
    left: i32
    top: i32
    right: i32
    bottom: i32
    layout: i32
}

struct GlyphInfo {
    value: i32
    offsetX: i32
    offsetY: i32
    advanceX: i32
    image: Image
}

struct Font {
    baseSize: i32
    glyphCount: i32
    glyphPadding: i32
    texture: Texture
    recs: &Rectangle
    glyphs: &GlyphInfo
}

struct Camera3D {
    position: Vector3
    target: Vector3
    up: Vector3
    fovy: f32
    projection: i32
}

// Camera = Camera3D

struct Camera2D {
    offset: Vector2
    target: Vector2
    rotation: f32
    zoom: f32
}

struct Mesh {
    vertexCount: i32
    triangleCount: i32
    vertices: &f32
    texcoords: &f32
    texcoords2: &f32
    normals: &f32
    tangents: &f32
    colors: &u8
    indices: &u16
    boneCount: i32
    boneIndices: &u8
    boneWeights: &f32
    animVertices: &f32
    animNormals: &f32
    vaoId: u32
    vboId: &u32
}

struct Shader {
    id: u32
    locs: &i32
}

struct MaterialMap {
    texture: Texture
    color: Color
    value: f32
}

struct Material {
    shader: Shader
    maps: &MaterialMap
    params: [4]f32
}

struct Transform {
    translation: Vector3
    rotation: Vector4
    scale: Vector3
}

// typedef Transform* ModelAnimPose

struct BoneInfo {
    name: [32]u8
    parent: i32
}

struct ModelSkeleton {
    boneCount: i32
    bones: &BoneInfo
    bindPose: &Transform
}

struct Model {
    transform: Matrix
    meshCount: i32
    materialCount: i32
    meshes: &Mesh
    materials: &Material
    meshMaterial: &i32
    skeleton: ModelSkeleton
    currentPose: &Transform
    boneMatrices: &Matrix
}

struct ModelAnimation {
    name: [32]u8
    boneCount: i32
    keyframeCount: i32
    keyframePoses: cstr
}

struct Ray {
    position: Vector3
    direction: Vector3
}

struct RayCollision {
    hit: bool
    distance: f32
    point: Vector3
    normal: Vector3
}

struct BoundingBox {
    min: Vector3
    max: Vector3
}

struct Wave {
    frameCount: u32
    sampleRate: u32
    sampleSize: u32
    channels: u32
    data: cstr
}

struct AudioStream {
    buffer: cstr
    processor: cstr
    sampleRate: u32
    sampleSize: u32
    channels: u32
}

struct Sound {
    stream: AudioStream
    frameCount: u32
}

struct Music {
    stream: AudioStream
    frameCount: u32
    looping: bool
    ctxType: i32
    ctxData: cstr
}

struct VrDeviceInfo {
    hResolution: i32
    vResolution: i32
    hScreenSize: f32
    vScreenSize: f32
    eyeToScreenDistance: f32
    lensSeparationDistance: f32
    interpupillaryDistance: f32
    lensDistortionValues: [4]f32
    chromaAbCorrection: [4]f32
}

struct VrStereoConfig {
    projection: [2]Matrix
    viewOffset: [2]Matrix
    leftLensCenter: [2]f32
    rightLensCenter: [2]f32
    leftScreenCenter: [2]f32
    rightScreenCenter: [2]f32
    scale: [2]f32
    scaleIn: [2]f32
}

struct FilePathList {
    count: u32
    // paths: char** - not supported
}

struct AutomationEvent {
    frame: u32
    type: u32
    params: [4]i32
}

struct AutomationEventList {
    capacity: u32
    count: u32
    events: &AutomationEvent
}

// === ENUMS (raylib 5.5) ===

